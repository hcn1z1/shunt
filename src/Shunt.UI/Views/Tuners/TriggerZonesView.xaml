<UserControl x:Class="Shunt.UI.Views.Tuners.TriggerZonesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="650" d:DesignWidth="900">
    <Grid Background="{StaticResource CanvasBackgroundBrush}" Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- 3-Zone Trigger Partition Visualizer -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceLevel1Brush}"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <TextBlock Grid.Row="0" Text="Trigger Partition Zones (3-Zone)" Style="{StaticResource SectionHeaderText}" Margin="0,0,0,16"/>

                <!-- Interactive Trigger Zone Bars -->
                <Grid Grid.Row="1" Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Zone Labels & Action Binds -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="35*"/>
                            <ColumnDefinition Width="40*"/>
                            <ColumnDefinition Width="25*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{StaticResource SurfaceLevel3Brush}" CornerRadius="4" Padding="8" Margin="2">
                            <StackPanel>
                                <TextBlock Text="Zone 1: Low" Style="{StaticResource BodyBoldText}" Foreground="{StaticResource Shift3Brush}"/>
                                <TextBlock Text="Soft Aim / Walk" Style="{StaticResource BodyMutedText}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{StaticResource SurfaceLevel3Brush}" CornerRadius="4" Padding="8" Margin="2">
                            <StackPanel>
                                <TextBlock Text="Zone 2: Mid" Style="{StaticResource BodyBoldText}" Foreground="{StaticResource Shift0Brush}"/>
                                <TextBlock Text="Regular Fire / Jog" Style="{StaticResource BodyMutedText}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="{StaticResource SurfaceLevel3Brush}" CornerRadius="4" Padding="8" Margin="2">
                            <StackPanel>
                                <TextBlock Text="Zone 3: High" Style="{StaticResource BodyBoldText}" Foreground="{StaticResource StatusSuccessBrush}"/>
                                <TextBlock Text="Overcharge / Sprint" Style="{StaticResource BodyMutedText}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Large Segmented Trigger Bar -->
                    <Border Grid.Row="1" Background="{StaticResource SurfaceLevel2Brush}" CornerRadius="6"
                            BorderBrush="{StaticResource BorderNormalBrush}" BorderThickness="1" ClipToBounds="True">
                        <Grid>
                            <!-- Simulated Trigger Fill Level -->
                            <ProgressBar x:Name="TriggerPullProgress" Value="60" Maximum="100"
                                         Foreground="{StaticResource AccentCreamBrush}" Background="Transparent"
                                         BorderThickness="0" Height="40" Margin="12" VerticalAlignment="Center"/>

                            <!-- Watermark / Grid Lines -->
                            <Canvas x:Name="ZoneDividerCanvas" Height="64">
                                <Line x:Name="Divider1" Stroke="{StaticResource Shift3Brush}" StrokeThickness="3" StrokeDashArray="2,2"/>
                                <Line x:Name="Divider2" Stroke="{StaticResource Shift0Brush}" StrokeThickness="3" StrokeDashArray="2,2"/>
                            </Canvas>
                        </Grid>
                    </Border>

                    <!-- Threshold Sliders -->
                    <StackPanel Grid.Row="2" Margin="0,16,0,0">
                        <DockPanel Margin="0,4,0,8">
                            <TextBlock Text="Threshold 1 (Low -> Mid):" Style="{StaticResource BodyBoldText}"/>
                            <TextBlock x:Name="T1ValueText" Text="35%" Style="{StaticResource BodyText}" DockPanel.Dock="Right"/>
                            <Slider x:Name="T1Slider" Minimum="10" Maximum="50" Value="35" Margin="12,0" ValueChanged="OnThresholdChanged"/>
                        </DockPanel>

                        <DockPanel Margin="0,4,0,8">
                            <TextBlock Text="Threshold 2 (Mid -> High):" Style="{StaticResource BodyBoldText}"/>
                            <TextBlock x:Name="T2ValueText" Text="75%" Style="{StaticResource BodyText}" DockPanel.Dock="Right"/>
                            <Slider x:Name="T2Slider" Minimum="55" Maximum="95" Value="75" Margin="12,0" ValueChanged="OnThresholdChanged"/>
                        </DockPanel>

                        <DockPanel Margin="0,4,0,0">
                            <TextBlock Text="Simulate Trigger Pull:" Style="{StaticResource BodyMutedText}"/>
                            <Slider x:Name="SimulatePullSlider" Minimum="0" Maximum="100" Value="60" Margin="12,0" ValueChanged="OnSimulateChanged"/>
                        </DockPanel>
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="2" Text="Partitions physical analog pull into distinct actionable trigger zones." Style="{StaticResource BodyMutedText}"/>
            </Grid>
        </Border>

        <!-- DualSense Adaptive Trigger Effects -->
        <Border Grid.Column="1" Background="{StaticResource SurfaceLevel1Brush}"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="12,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="DualSense Adaptive Triggers" Style="{StaticResource SectionHeaderText}" Margin="0,0,0,16"/>

                    <TextBlock Text="Effect Profile" Style="{StaticResource BodyBoldText}" Margin="0,0,0,6"/>
                    <ComboBox x:Name="EffectProfileCombo" SelectionChanged="OnEffectProfileChanged" Margin="0,0,0,16">
                        <ComboBoxItem Content="Rigid (Hard Stop)" IsSelected="True"/>
                        <ComboBoxItem Content="Pulse (Recoil Vibration)"/>
                        <ComboBoxItem Content="Bow (Increasing Tension)"/>
                        <ComboBoxItem Content="Machine Gun (Heavy Oscillations)"/>
                        <ComboBoxItem Content="Semi-Automatic (Distinct Wall Break)"/>
                    </ComboBox>

                    <!-- Start Position -->
                    <DockPanel Margin="0,4,0,12">
                        <TextBlock Text="Start Position" Style="{StaticResource BodyBoldText}"/>
                        <TextBlock x:Name="StartPosVal" Text="20%" Style="{StaticResource BodyMutedText}" DockPanel.Dock="Right"/>
                        <Slider x:Name="StartPosSlider" Minimum="0" Maximum="100" Value="20" ValueChanged="OnEffectParamChanged"/>
                    </DockPanel>

                    <!-- End Position -->
                    <DockPanel Margin="0,4,0,12">
                        <TextBlock Text="End Position" Style="{StaticResource BodyBoldText}"/>
                        <TextBlock x:Name="EndPosVal" Text="70%" Style="{StaticResource BodyMutedText}" DockPanel.Dock="Right"/>
                        <Slider x:Name="EndPosSlider" Minimum="0" Maximum="100" Value="70" ValueChanged="OnEffectParamChanged"/>
                    </DockPanel>

                    <!-- Resistance Force -->
                    <DockPanel Margin="0,4,0,12">
                        <TextBlock Text="Resistance Force" Style="{StaticResource BodyBoldText}"/>
                        <TextBlock x:Name="ForceVal" Text="85%" Style="{StaticResource BodyMutedText}" DockPanel.Dock="Right"/>
                        <Slider x:Name="ForceSlider" Minimum="0" Maximum="100" Value="85" ValueChanged="OnEffectParamChanged"/>
                    </DockPanel>

                    <!-- Frequency -->
                    <DockPanel Margin="0,4,0,16">
                        <TextBlock Text="Frequency (Pulse/Auto)" Style="{StaticResource BodyBoldText}"/>
                        <TextBlock x:Name="FreqVal" Text="15 Hz" Style="{StaticResource BodyMutedText}" DockPanel.Dock="Right"/>
                        <Slider x:Name="FreqSlider" Minimum="1" Maximum="25" Value="15" ValueChanged="OnEffectParamChanged"/>
                    </DockPanel>

                    <Separator Background="{StaticResource BorderSubtleBrush}" Margin="0,8,0,16"/>

                    <TextBlock Text="Status: Connected (DualSense Wireless Controller)" Style="{StaticResource BodyText}" Foreground="{StaticResource StatusSuccessBrush}"/>
                    <Button Content="Test Trigger Resistance" Style="{StaticResource PrimaryButton}" Margin="0,12,0,0" Click="OnTestTriggerClick"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
