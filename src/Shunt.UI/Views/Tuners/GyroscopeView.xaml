<UserControl x:Class="Shunt.UI.Views.Tuners.GyroscopeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1050">
    <Grid Background="{StaticResource CanvasBackgroundBrush}" Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="390"/>
        </Grid.ColumnDefinitions>

        <!-- ======================= LEFT: 3D MOTION STAGE & TELEMETRY ======================= -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceLevel1Brush}"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Top Mode Selector Pills -->
                    <RowDefinition Height="*"/>    <!-- 3D Artificial Horizon & Gimbal Stage -->
                    <RowDefinition Height="Auto"/> <!-- Live Telemetry Cards & Speed Meter -->
                    <RowDefinition Height="Auto"/> <!-- Noise Drift Calibration Wizard Bar -->
                </Grid.RowDefinitions>

                <!-- Mode Header & Pills -->
                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="GYROSCOPE MOTION &amp; TUNING" Style="{StaticResource SectionHeaderText}" VerticalAlignment="Center"/>
                        <Border Background="{StaticResource SurfaceLevel3Brush}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                            <TextBlock x:Name="ModeBadgeText" Text="MOUSE AIM" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCreamBrush}"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="PillMouseAim" Content="🎯 Mouse Aim" Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="2,0" Click="OnModePillClick"/>
                        <Button x:Name="PillRightStick" Content="🕹️ Stick Aim" Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="2,0" Click="OnModePillClick"/>
                        <Button x:Name="PillSteeringWheel" Content="🏎️ Steering Wheel" Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="2,0" Click="OnModePillClick"/>
                        <Button x:Name="PillTiltLean" Content="📐 Directional Tilt" Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="2,0" Click="OnModePillClick"/>
                    </StackPanel>
                </DockPanel>

                <!-- 3D Gimbal & Artificial Horizon Stage -->
                <Border Grid.Row="1" Background="{StaticResource SurfaceLevel2Brush}" CornerRadius="8"
                        BorderBrush="{StaticResource BorderNormalBrush}" BorderThickness="1" ClipToBounds="True" Margin="0,0,0,12">
                    <Grid x:Name="GimbalStageGrid" MouseDown="OnGimbalMouseDown" MouseMove="OnGimbalMouseMove" MouseUp="OnGimbalMouseUp" Cursor="Hand">
                        <!-- Subtle Background Grid -->
                        <Canvas IsHitTestVisible="False">
                            <Line X1="0" Y1="175" X2="600" Y2="175" Stroke="#15FFFFFF" StrokeDashArray="3,3"/>
                            <Line X1="300" Y1="0" X2="300" Y2="350" Stroke="#15FFFFFF" StrokeDashArray="3,3"/>
                        </Canvas>

                        <!-- Directional Tilt Glow Badges around the viewport -->
                        <!-- Tilt UP -->
                        <Border x:Name="BadgeTiltUp" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0"
                                Background="{StaticResource SurfaceLevel3Brush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="12,5" IsHitTestVisible="False">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▲ TILT UP" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" x:Name="TextTiltUp"/>
                            </StackPanel>
                        </Border>

                        <!-- Tilt DOWN -->
                        <Border x:Name="BadgeTiltDown" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16"
                                Background="{StaticResource SurfaceLevel3Brush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="12,5" IsHitTestVisible="False">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▼ TILT DOWN" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" x:Name="TextTiltDown"/>
                            </StackPanel>
                        </Border>

                        <!-- Tilt / Lean LEFT -->
                        <Border x:Name="BadgeTiltLeft" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0"
                                Background="{StaticResource SurfaceLevel3Brush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="8,10" IsHitTestVisible="False">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="◄ LEAN LEFT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" x:Name="TextTiltLeft"/>
                            </StackPanel>
                        </Border>

                        <!-- Tilt / Lean RIGHT -->
                        <Border x:Name="BadgeTiltRight" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0"
                                Background="{StaticResource SurfaceLevel3Brush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="8,10" IsHitTestVisible="False">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="LEAN RIGHT ►" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" x:Name="TextTiltRight"/>
                            </StackPanel>
                        </Border>

                        <!-- Central Horizon Gimbal Viewport (320x320 sphere) -->
                        <Grid Width="320" Height="320" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Outer Bezel Ring -->
                            <Ellipse Stroke="{StaticResource BorderStrongBrush}" StrokeThickness="2" Fill="#141414"/>

                            <!-- Rotating Roll Disc (Driven by Roll Angle Transform) -->
                            <Grid x:Name="RollContainer" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <RotateTransform x:Name="RollRotateTransform" Angle="0"/>
                                </Grid.RenderTransform>

                                <!-- Artificial Horizon Ground Half (Sky vs Ground) -->
                                <Canvas Width="320" Height="320" ClipToBounds="True">
                                    <Canvas.Clip>
                                        <EllipseGeometry Center="160,160" RadiusX="158" RadiusY="158"/>
                                    </Canvas.Clip>

                                    <!-- Translating Pitch Ladder Layer (Driven by Pitch Transform) -->
                                    <Canvas x:Name="PitchLadderCanvas" Width="320" Height="640" Canvas.Top="-160">
                                        <Canvas.RenderTransform>
                                            <TranslateTransform x:Name="PitchTranslateTransform" Y="0"/>
                                        </Canvas.RenderTransform>

                                        <!-- Horizon Separator Line (0 deg) -->
                                        <Line X1="30" Y1="320" X2="290" Y2="320" Stroke="{StaticResource AccentCreamBrush}" StrokeThickness="2.5"/>
                                        <Polygon Points="160,314 154,320 166,320" Fill="{StaticResource AccentCreamBrush}"/>

                                        <!-- Pitch Ladder rungs (+30, +60, -30, -60) -->
                                        <Line X1="80" Y1="240" X2="240" Y2="240" Stroke="#70FFE795" StrokeThickness="1.5" StrokeDashArray="4,4"/>
                                        <TextBlock Text="+30°" Canvas.Left="48" Canvas.Top="232" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="+30°" Canvas.Left="248" Canvas.Top="232" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>

                                        <Line X1="110" Y1="160" X2="210" Y2="160" Stroke="#50FFE795" StrokeThickness="1.5" StrokeDashArray="2,2"/>
                                        <TextBlock Text="+60°" Canvas.Left="78" Canvas.Top="152" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="+60°" Canvas.Left="218" Canvas.Top="152" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>

                                        <Line X1="80" Y1="400" X2="240" Y2="400" Stroke="#70FFE795" StrokeThickness="1.5" StrokeDashArray="4,4"/>
                                        <TextBlock Text="-30°" Canvas.Left="48" Canvas.Top="392" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="-30°" Canvas.Left="248" Canvas.Top="392" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>

                                        <Line X1="110" Y1="480" X2="210" Y2="480" Stroke="#50FFE795" StrokeThickness="1.5" StrokeDashArray="2,2"/>
                                        <TextBlock Text="-60°" Canvas.Left="78" Canvas.Top="472" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="-60°" Canvas.Left="218" Canvas.Top="472" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                    </Canvas>
                                </Canvas>

                                <!-- Outer Roll Angle Pointer Tick Marks -->
                                <Line X1="160" Y1="4" X2="160" Y2="16" Stroke="{StaticResource AccentCreamBrush}" StrokeThickness="2.5"/>
                                <Line X1="160" Y1="304" X2="160" Y2="316" Stroke="{StaticResource BorderNormalBrush}" StrokeThickness="1.5"/>
                                <Line X1="4" Y1="160" X2="16" Y2="160" Stroke="{StaticResource BorderNormalBrush}" StrokeThickness="1.5"/>
                                <Line X1="304" Y1="160" X2="316" Y2="160" Stroke="{StaticResource BorderNormalBrush}" StrokeThickness="1.5"/>
                            </Grid>

                            <!-- Fixed Center Aim Reticle / Controller Wireframe Glyph -->
                            <Canvas Width="320" Height="320" IsHitTestVisible="False">
                                <!-- Crosshair Rings -->
                                <Ellipse Canvas.Left="140" Canvas.Top="140" Width="40" Height="40"
                                         Stroke="{StaticResource AccentCreamBrush}" StrokeThickness="1.5" Fill="#20FFE795">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#FFE795" Opacity="0.6"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                                <Ellipse Canvas.Left="156" Canvas.Top="156" Width="8" Height="8" Fill="{StaticResource AccentCreamBrush}"/>
                                <Line X1="110" Y1="160" X2="135" Y2="160" Stroke="{StaticResource AccentCreamBrush}" StrokeThickness="2"/>
                                <Line X1="185" Y1="160" X2="210" Y2="160" Stroke="{StaticResource AccentCreamBrush}" StrokeThickness="2"/>
                                <Line X1="160" Y1="110" X2="160" Y2="135" Stroke="{StaticResource AccentCreamBrush}" StrokeThickness="2"/>
                                <Line X1="160" Y1="185" X2="160" Y2="210" Stroke="{StaticResource AccentCreamBrush}" StrokeThickness="2"/>

                                <!-- Stylized Controller Miniature Wireframe -->
                                <Path Canvas.Left="132" Canvas.Top="215"
                                      Data="M 6,3 L 50,3 C 54,3 56,6 55,10 L 52,24 C 51,28 47,30 43,28 L 36,25 L 20,25 L 13,28 C 9,30 5,28 4,24 L 1,10 C 0,6 2,3 6,3 Z"
                                      Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.2" Fill="#40202020"/>
                            </Canvas>

                            <!-- Steering Wheel Overlay (Visible in Steering Wheel Mode) -->
                            <Grid x:Name="SteeringWheelOverlay" Visibility="Collapsed" IsHitTestVisible="False">
                                <Ellipse Width="240" Height="240" Stroke="{StaticResource Shift3Brush}" StrokeThickness="4" StrokeDashArray="12,4"/>
                                <Line X1="40" Y1="160" X2="280" Y2="160" Stroke="{StaticResource Shift3Brush}" StrokeThickness="3"/>
                                <Line X1="160" Y1="160" X2="160" Y2="280" Stroke="{StaticResource Shift3Brush}" StrokeThickness="3"/>
                            </Grid>
                        </Grid>

                        <!-- Interactive Recenter & Hint Badge -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8" Orientation="Horizontal">
                            <TextBlock Text="💡 Click &amp; drag sphere to simulate physical motion" Style="{StaticResource BodyMutedText}" FontSize="10" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Button x:Name="ResetOrientationBtn" Content="⟲ Recenter Orientation" Style="{StaticResource SecondaryButton}" Padding="8,4" Click="OnResetOrientationClick"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Live Telemetry Readout & Angular Velocity Meter -->
                <Grid Grid.Row="2" Margin="0,0,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Telemetry Cards -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1.2*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Pitch -->
                        <Border Grid.Column="0" Background="{StaticResource SurfaceLevel2Brush}" CornerRadius="6" Padding="10,8" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="PITCH (Y)" Style="{StaticResource BodyMutedText}" FontSize="10"/>
                                <TextBlock x:Name="TelemetryPitchText" Text="+0.0°" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="TelemetryPitchRateText" Text="0.0 °/s" Style="{StaticResource BodyMutedText}" FontSize="10"/>
                            </StackPanel>
                        </Border>

                        <!-- Roll -->
                        <Border Grid.Column="1" Background="{StaticResource SurfaceLevel2Brush}" CornerRadius="6" Padding="10,8" Margin="3,0,3,0">
                            <StackPanel>
                                <TextBlock Text="ROLL (X)" Style="{StaticResource BodyMutedText}" FontSize="10"/>
                                <TextBlock x:Name="TelemetryRollText" Text="+0.0°" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="TelemetryRollRateText" Text="0.0 °/s" Style="{StaticResource BodyMutedText}" FontSize="10"/>
                            </StackPanel>
                        </Border>

                        <!-- Yaw -->
                        <Border Grid.Column="2" Background="{StaticResource SurfaceLevel2Brush}" CornerRadius="6" Padding="10,8" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="YAW (Z)" Style="{StaticResource BodyMutedText}" FontSize="10"/>
                                <TextBlock x:Name="TelemetryYawText" Text="0.0°" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="TelemetryYawRateText" Text="0.0 °/s" Style="{StaticResource BodyMutedText}" FontSize="10"/>
                            </StackPanel>
                        </Border>

                        <!-- Motion Status & Rate Gauge -->
                        <Border Grid.Column="3" Background="{StaticResource SurfaceLevel2Brush}" CornerRadius="6" Padding="10,8" Margin="6,0,0,0">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="MOTION ACTIVITY" Style="{StaticResource BodyMutedText}" FontSize="10"/>
                                    <Ellipse x:Name="MotionStatusLed" Width="8" Height="8" Fill="{StaticResource StatusSuccessBrush}" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <TextBlock x:Name="TelemetryStatusText" Text="STABLE / IDLE" FontSize="14" FontWeight="Bold" Foreground="{StaticResource StatusSuccessBrush}" Margin="0,2,0,2"/>
                                <ProgressBar x:Name="AngularSpeedMeter" Height="6" Minimum="0" Maximum="100" Value="0"
                                             Foreground="{StaticResource AccentCreamBrush}" Background="{StaticResource SurfaceLevel4Brush}" BorderThickness="0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Noise Drift Calibration Wizard Bar -->
                <Border Grid.Row="3" Background="{StaticResource SurfaceLevel2Brush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="SENSOR DRIFT CALIBRATION" Style="{StaticResource BodyBoldText}" FontSize="11"/>
                            <TextBlock x:Name="CalibrationStatusText" Text="Place controller on a flat motionless surface and calibrate to eliminate drift."
                                       Style="{StaticResource BodyMutedText}" FontSize="11" TextWrapping="Wrap"/>
                            <!-- Animated calibration sampling progress bar -->
                            <ProgressBar x:Name="CalibrationProgressBar" Height="4" Minimum="0" Maximum="100" Value="0"
                                         Foreground="{StaticResource StatusSuccessBrush}" Background="{StaticResource SurfaceLevel4Brush}"
                                         BorderThickness="0" Margin="0,6,12,0" Visibility="Collapsed"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="CalibrateGyroBtn" Content="⚡ Calibrate Gyroscope" Style="{StaticResource PrimaryButton}"
                                    Padding="14,6" Margin="0,0,6,0" Click="OnCalibrateGyroClick"/>
                            <Button x:Name="ResetCalibrationBtn" Content="Reset Bias" Style="{StaticResource SecondaryButton}"
                                    Padding="10,6" Click="OnResetCalibrationClick"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ======================= RIGHT: GYRO SETTINGS & TUNING SIDEBAR ======================= -->
        <Border Grid.Column="1" Background="{StaticResource SurfaceLevel1Brush}"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="12,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Gyroscope Configuration" Style="{StaticResource SectionHeaderText}" Margin="0,0,0,14"/>

                    <!-- Mode Selection -->
                    <TextBlock Text="OPERATING MODE" Style="{StaticResource BodyBoldText}" FontSize="11" Margin="0,0,0,4"/>
                    <ComboBox x:Name="OperatingModeCombo" Style="{StaticResource DarkComboBox}"
                              ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                              SelectionChanged="OnOperatingModeChanged" Margin="0,0,0,12">
                        <ComboBoxItem Content="🎯 Gyro-to-Mouse (Aiming)"/>
                        <ComboBoxItem Content="🕹️ Gyro-to-Right Stick (Aiming)"/>
                        <ComboBoxItem Content="🕹️ Gyro-to-Left Stick (Movement)"/>
                        <ComboBoxItem Content="🏎️ Steering Wheel Mode"/>
                        <ComboBoxItem Content="📐 Directional Tilt &amp; Lean"/>
                    </ComboBox>

                    <!-- Activator / Modifier -->
                    <TextBlock Text="ACTIVATOR MODIFIER" Style="{StaticResource BodyBoldText}" FontSize="11" Margin="0,0,0,4"/>
                    <ComboBox x:Name="ActivatorModeCombo" Style="{StaticResource DarkComboBox}"
                              ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                              SelectionChanged="OnActivatorModeChanged" Margin="0,0,0,14">
                        <ComboBoxItem Content="Always On (Continuous)"/>
                        <ComboBoxItem Content="Hold: Left Trigger (Aim Down Sights)"/>
                        <ComboBoxItem Content="Hold: Right Bumper (Tactical Aim)"/>
                        <ComboBoxItem Content="Hold: Left Bumper"/>
                        <ComboBoxItem Content="Hold: Touchpad Click"/>
                        <ComboBoxItem Content="Toggle (Press Button to Turn On/Off)"/>
                        <ComboBoxItem Content="Inverted Hold (Release Button to Turn Off)"/>
                    </ComboBox>

                    <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,0,0,14"/>

                    <!-- Aiming & Sensitivity Sliders (Visible for Mouse / Stick modes) -->
                    <StackPanel x:Name="AimingTuningSection">
                        <TextBlock Text="SENSITIVITY &amp; DEFLECTION" Style="{StaticResource BodyBoldText}" FontSize="11" Margin="0,0,0,10"/>

                        <!-- Multiplier X -->
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Horizontal Sensitivity (X):" Style="{StaticResource BodyMutedText}"/>
                            <TextBlock x:Name="MultiplierXValueText" Text="1.00x" Style="{StaticResource BodyBoldText}" Foreground="{StaticResource AccentCreamBrush}" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <Slider x:Name="MultiplierXSlider" Minimum="0.1" Maximum="5.0" Value="1.0" SmallChange="0.05" LargeChange="0.2"
                                ValueChanged="OnMultiplierXChanged" Margin="0,0,0,10"/>

                        <!-- Multiplier Y -->
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Vertical Sensitivity (Y):" Style="{StaticResource BodyMutedText}"/>
                            <TextBlock x:Name="MultiplierYValueText" Text="1.00x" Style="{StaticResource BodyBoldText}" Foreground="{StaticResource AccentCreamBrush}" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <Slider x:Name="MultiplierYSlider" Minimum="0.1" Maximum="5.0" Value="1.0" SmallChange="0.05" LargeChange="0.2"
                                ValueChanged="OnMultiplierYChanged" Margin="0,0,0,10"/>

                        <!-- Deadzone / Noise Threshold -->
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Noise Deadzone Threshold:" Style="{StaticResource BodyMutedText}"/>
                            <TextBlock x:Name="DeadzoneValueText" Text="0.50 °/s" Style="{StaticResource BodyBoldText}" Foreground="{StaticResource AccentCreamBrush}" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <Slider x:Name="DeadzoneSlider" Minimum="0.0" Maximum="5.0" Value="0.5" SmallChange="0.05" LargeChange="0.25"
                                ValueChanged="OnDeadzoneChanged" Margin="0,0,0,10"/>

                        <!-- Acceleration Factor -->
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Acceleration / Response Curve:" Style="{StaticResource BodyMutedText}"/>
                            <TextBlock x:Name="AccelerationValueText" Text="1.00" Style="{StaticResource BodyBoldText}" Foreground="{StaticResource AccentCreamBrush}" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <Slider x:Name="AccelerationSlider" Minimum="1.0" Maximum="3.0" Value="1.0" SmallChange="0.05" LargeChange="0.2"
                                ValueChanged="OnAccelerationChanged" Margin="0,0,0,12"/>

                        <!-- Invert Checkboxes -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="InvertXCheck" Grid.Column="0" Content="Invert Horizontal (Yaw)"
                                      Style="{StaticResource DarkCheckBox}" Checked="OnInvertChanged" Unchecked="OnInvertChanged"/>
                            <CheckBox x:Name="InvertYCheck" Grid.Column="1" Content="Invert Vertical (Pitch)"
                                      Style="{StaticResource DarkCheckBox}" Checked="OnInvertChanged" Unchecked="OnInvertChanged"/>
                        </Grid>

                        <!-- Horizontal Axis Choice: Yaw vs Roll -->
                        <TextBlock Text="HORIZONTAL STEERING AXIS" Style="{StaticResource BodyBoldText}" FontSize="10" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <RadioButton x:Name="AxisYawRadio" Content="Yaw (Standard Aiming)" GroupName="GyroAxis" IsChecked="True"
                                         Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,16,0" Checked="OnAxisRadioChanged"/>
                            <RadioButton x:Name="AxisRollRadio" Content="Roll (Wheel / Leaning)" GroupName="GyroAxis"
                                         Foreground="{StaticResource TextSecondaryBrush}" Checked="OnAxisRadioChanged"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Steering Wheel Section (Visible in SteeringWheel mode) -->
                    <StackPanel x:Name="SteeringWheelSection" Visibility="Collapsed">
                        <TextBlock Text="STEERING WHEEL CALIBRATION" Style="{StaticResource BodyBoldText}" FontSize="11" Margin="0,0,0,10"/>

                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Steering Rotation Range:" Style="{StaticResource BodyMutedText}"/>
                            <TextBlock x:Name="SteeringRangeValueText" Text="270°" Style="{StaticResource BodyBoldText}" Foreground="{StaticResource Shift3Brush}" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <ComboBox x:Name="SteeringRangeCombo" Style="{StaticResource DarkComboBox}"
                                  ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                                  SelectionChanged="OnSteeringRangeChanged" Margin="0,0,0,10">
                            <ComboBoxItem Content="180° (Quick Racing)"/>
                            <ComboBoxItem Content="270° (Standard Sim)"/>
                            <ComboBoxItem Content="360° (Full Turn)"/>
                            <ComboBoxItem Content="900° (Pro Rig Simulation)"/>
                        </ComboBox>

                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Return-to-Center Spring Damping:" Style="{StaticResource BodyMutedText}"/>
                            <TextBlock x:Name="ReturnSpringValueText" Text="80%" Style="{StaticResource BodyBoldText}" Foreground="{StaticResource Shift3Brush}" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <Slider x:Name="ReturnSpringSlider" Minimum="0" Maximum="100" Value="80"
                                ValueChanged="OnReturnSpringChanged" Margin="0,0,0,12"/>
                    </StackPanel>

                    <!-- Directional Tilt & Lean Zones (Visible in DirectionalTilt mode) -->
                    <StackPanel x:Name="TiltZonesSection" Visibility="Collapsed">
                        <TextBlock Text="DIRECTIONAL TILT THRESHOLDS" Style="{StaticResource BodyBoldText}" FontSize="11" Margin="0,0,0,10"/>

                        <!-- Low Threshold -->
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Zone 1: Soft Tilt (Lean Low):" Style="{StaticResource BodyMutedText}"/>
                            <TextBlock x:Name="TiltLowValueText" Text="15°" Style="{StaticResource BodyBoldText}" Foreground="{StaticResource Shift3Brush}" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <Slider x:Name="TiltLowSlider" Minimum="5" Maximum="30" Value="15"
                                ValueChanged="OnTiltThresholdChanged" Margin="0,0,0,8"/>

                        <!-- Med Threshold -->
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Zone 2: Medium Tilt (Lean Med):" Style="{StaticResource BodyMutedText}"/>
                            <TextBlock x:Name="TiltMedValueText" Text="30°" Style="{StaticResource BodyBoldText}" Foreground="{StaticResource Shift0Brush}" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <Slider x:Name="TiltMedSlider" Minimum="20" Maximum="50" Value="30"
                                ValueChanged="OnTiltThresholdChanged" Margin="0,0,0,8"/>

                        <!-- High Threshold -->
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Zone 3: Steep Tilt (Lean High):" Style="{StaticResource BodyMutedText}"/>
                            <TextBlock x:Name="TiltHighValueText" Text="45°" Style="{StaticResource BodyBoldText}" Foreground="{StaticResource StatusSuccessBrush}" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <Slider x:Name="TiltHighSlider" Minimum="35" Maximum="70" Value="45"
                                ValueChanged="OnTiltThresholdChanged" Margin="0,0,0,12"/>

                        <!-- Mapped Actions Summary -->
                        <Border Background="{StaticResource SurfaceLevel2Brush}" CornerRadius="4" Padding="8" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="TACTICAL LEAN BINDS:" Style="{StaticResource BodyBoldText}" FontSize="10" Margin="0,0,0,4"/>
                                <TextBlock Text="◄ Lean Left: Keyboard [Q] / LB" Style="{StaticResource BodyMutedText}" FontSize="11"/>
                                <TextBlock Text="► Lean Right: Keyboard [E] / RB" Style="{StaticResource BodyMutedText}" FontSize="11"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,0,0,14"/>

                    <!-- Presets -->
                    <TextBlock Text="TUNING PRESETS" Style="{StaticResource BodyBoldText}" FontSize="11" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Button x:Name="PresetFastAim" Grid.Row="0" Grid.Column="0" Content="Fast Aim (FPS)"
                                Style="{StaticResource SecondaryButton}" Padding="6,6" Margin="0,0,4,6" Click="OnPresetClick"/>
                        <Button x:Name="PresetPrecision" Grid.Row="0" Grid.Column="1" Content="Sniper Precision"
                                Style="{StaticResource SecondaryButton}" Padding="6,6" Margin="4,0,0,6" Click="OnPresetClick"/>
                        <Button x:Name="PresetRacing" Grid.Row="1" Grid.Column="0" Content="Racing Wheel"
                                Style="{StaticResource SecondaryButton}" Padding="6,6" Margin="0,0,4,0" Click="OnPresetClick"/>
                        <Button x:Name="PresetLeanQE" Grid.Row="1" Grid.Column="1" Content="Tactical Lean (Q/E)"
                                Style="{StaticResource SecondaryButton}" Padding="6,6" Margin="4,0,0,0" Click="OnPresetClick"/>
                    </Grid>

                    <!-- Save & Defaults Buttons -->
                    <Button x:Name="ApplyToProfileBtn" Content="Apply Gyro to Profile" Style="{StaticResource PrimaryButton}"
                            Click="OnApplyToProfileClick" Margin="0,0,0,8"/>
                    <Button x:Name="ResetDefaultsBtn" Content="Reset All to Defaults" Style="{StaticResource SecondaryButton}"
                            Click="OnResetDefaultsClick"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
