<UserControl x:Class="Shunt.UI.Views.Tuners.ShuntModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="720" d:DesignWidth="1100">
    <Grid Background="{StaticResource CanvasBackgroundBrush}" Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- ======================= LEFT: 3D MOTION HORIZON, SENSOR TELEMETRY & CHORDS GUIDE ======================= -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceLevel1Brush}"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,16,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header & Diagnostic Wizard button -->
                    <RowDefinition Height="*"/>    <!-- 3D Artificial Horizon & Gimbal Stage -->
                    <RowDefinition Height="Auto"/> <!-- Live 4-Card Telemetry & Health Grid -->
                    <RowDefinition Height="Auto"/> <!-- Interactive Touchpad & Chord Shortcuts Reference Card -->
                </Grid.RowDefinitions>

                <!-- Header -->
                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="SHUNT MODE — XBOX TO DUALSHOCK 4 RUNTIME" Style="{StaticResource SectionHeaderText}" VerticalAlignment="Center"/>
                        <Border Background="{StaticResource SurfaceLevel3Brush}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                            <TextBlock Text="XBOX → DS4 PASSTHROUGH" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCreamBrush}"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="LaunchWizardTopBtn" Content="🎯 Gyro Diagnostic Wizard" Style="{StaticResource SecondaryButton}" Padding="10,5" Click="OnLaunchWizardClick"/>
                    </StackPanel>
                </DockPanel>

                <!-- 3D Gimbal & Artificial Horizon Stage -->
                <Border Grid.Row="1" Background="{StaticResource SurfaceLevel2Brush}" CornerRadius="8"
                        BorderBrush="{StaticResource BorderNormalBrush}" BorderThickness="1" ClipToBounds="True" Margin="0,0,0,12">
                    <Grid x:Name="GimbalStageGrid" MouseDown="OnGimbalMouseDown" MouseMove="OnGimbalMouseMove" MouseUp="OnGimbalMouseUp" Cursor="Hand">
                        <!-- Subtle Background Grid -->
                        <Canvas IsHitTestVisible="False">
                            <Line X1="0" Y1="160" X2="700" Y2="160" Stroke="#15FFFFFF" StrokeDashArray="3,3"/>
                            <Line X1="350" Y1="0" X2="350" Y2="320" Stroke="#15FFFFFF" StrokeDashArray="3,3"/>
                        </Canvas>

                        <!-- Directional Tilt Badges -->
                        <Border x:Name="BadgeTiltUp" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0"
                                Background="{StaticResource SurfaceLevel3Brush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="10,4" IsHitTestVisible="False">
                            <TextBlock x:Name="TextTiltUp" Text="▲ PITCH UP" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        </Border>

                        <Border x:Name="BadgeTiltDown" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12"
                                Background="{StaticResource SurfaceLevel3Brush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="10,4" IsHitTestVisible="False">
                            <TextBlock x:Name="TextTiltDown" Text="▼ PITCH DOWN" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        </Border>

                        <Border x:Name="BadgeTiltLeft" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"
                                Background="{StaticResource SurfaceLevel3Brush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="8,8" IsHitTestVisible="False">
                            <TextBlock x:Name="TextTiltLeft" Text="◄ ROLL LEFT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        </Border>

                        <Border x:Name="BadgeTiltRight" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                                Background="{StaticResource SurfaceLevel3Brush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="8,8" IsHitTestVisible="False">
                            <TextBlock x:Name="TextTiltRight" Text="ROLL RIGHT ►" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        </Border>

                        <!-- Central Horizon Gimbal Viewport (280x280 sphere) -->
                        <Grid Width="280" Height="280" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Outer Bezel Ring -->
                            <Ellipse Stroke="{StaticResource BorderStrongBrush}" StrokeThickness="2" Fill="#141414"/>

                            <!-- Rotating Roll Disc (Driven by Roll Angle Transform) -->
                            <Grid x:Name="RollContainer" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <RotateTransform x:Name="RollRotateTransform" Angle="0"/>
                                </Grid.RenderTransform>

                                <!-- Artificial Horizon Layer -->
                                <Canvas Width="280" Height="280" ClipToBounds="True">
                                    <Canvas.Clip>
                                        <EllipseGeometry Center="140,140" RadiusX="138" RadiusY="138"/>
                                    </Canvas.Clip>

                                    <!-- Translating Pitch Ladder Layer -->
                                    <Canvas x:Name="PitchLadderCanvas" Width="280" Height="560" Canvas.Top="-140">
                                        <Canvas.RenderTransform>
                                            <TranslateTransform x:Name="PitchTranslateTransform" Y="0"/>
                                        </Canvas.RenderTransform>

                                        <!-- Horizon Line (0 deg) in brand gold -->
                                        <Line X1="20" Y1="280" X2="260" Y2="280" Stroke="{StaticResource AccentCreamBrush}" StrokeThickness="2.5"/>
                                        <Polygon Points="140,274 134,280 146,280" Fill="{StaticResource AccentCreamBrush}"/>

                                        <!-- Pitch Ladder rungs (+30, +60, -30, -60) -->
                                        <Line X1="70" Y1="200" X2="210" Y2="200" Stroke="#70FFE795" StrokeThickness="1.5" StrokeDashArray="4,4"/>
                                        <TextBlock Text="+30°" Canvas.Left="40" Canvas.Top="192" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="+30°" Canvas.Left="216" Canvas.Top="192" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>

                                        <Line X1="100" Y1="120" X2="180" Y2="120" Stroke="#50FFE795" StrokeThickness="1.5" StrokeDashArray="2,2"/>
                                        <TextBlock Text="+60°" Canvas.Left="70" Canvas.Top="112" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="+60°" Canvas.Left="186" Canvas.Top="112" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>

                                        <Line X1="70" Y1="360" X2="210" Y2="360" Stroke="#70FFE795" StrokeThickness="1.5" StrokeDashArray="4,4"/>
                                        <TextBlock Text="-30°" Canvas.Left="40" Canvas.Top="352" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="-30°" Canvas.Left="216" Canvas.Top="352" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>

                                        <Line X1="100" Y1="440" X2="180" Y2="440" Stroke="#50FFE795" StrokeThickness="1.5" StrokeDashArray="2,2"/>
                                        <TextBlock Text="-60°" Canvas.Left="70" Canvas.Top="432" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="-60°" Canvas.Left="186" Canvas.Top="432" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                    </Canvas>
                                </Canvas>

                                <!-- Outer Roll Angle Pointer Tick Marks -->
                                <Line X1="140" Y1="4" X2="140" Y2="14" Stroke="{StaticResource AccentCreamBrush}" StrokeThickness="2.5"/>
                                <Line X1="140" Y1="266" X2="140" Y2="276" Stroke="{StaticResource BorderNormalBrush}" StrokeThickness="1.5"/>
                                <Line X1="4" Y1="140" X2="14" Y2="140" Stroke="{StaticResource BorderNormalBrush}" StrokeThickness="1.5"/>
                                <Line X1="266" Y1="140" X2="276" Y2="140" Stroke="{StaticResource BorderNormalBrush}" StrokeThickness="1.5"/>
                            </Grid>

                            <!-- Fixed Center Aim Reticle -->
                            <Canvas Width="280" Height="280" IsHitTestVisible="False">
                                <Ellipse Canvas.Left="122" Canvas.Top="122" Width="36" Height="36"
                                         Stroke="{StaticResource AccentCreamBrush}" StrokeThickness="1.5" Fill="#20FFE795"/>
                                <Ellipse Canvas.Left="137" Canvas.Top="137" Width="6" Height="6" Fill="{StaticResource AccentCreamBrush}"/>
                                <Line X1="100" Y1="140" X2="120" Y2="140" Stroke="{StaticResource AccentCreamBrush}" StrokeThickness="1.5"/>
                                <Line X1="160" Y1="140" X2="180" Y2="140" Stroke="{StaticResource AccentCreamBrush}" StrokeThickness="1.5"/>
                                <Line X1="140" Y1="100" X2="140" Y2="120" Stroke="{StaticResource AccentCreamBrush}" StrokeThickness="1.5"/>
                                <Line X1="140" Y1="160" X2="140" Y2="180" Stroke="{StaticResource AccentCreamBrush}" StrokeThickness="1.5"/>
                            </Canvas>
                        </Grid>

                        <!-- Orientation Readout Overlay -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0"
                                Background="{StaticResource SurfaceLevel3Brush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="8,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="PITCH: " FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="PitchReadoutText" Text="+0.0°" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCreamBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="ROLL: " FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="RollReadoutText" Text="+0.0°" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCreamBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="YAW: " FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="YawReadoutText" Text="0.0°" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCreamBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Reset Center Hint -->
                        <Button HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,10"
                                Style="{StaticResource SecondaryButton}" Content="Center Horizon" Padding="8,3" FontSize="10"
                                Click="OnResetOrientationClick"/>
                    </Grid>
                </Border>

                <!-- Live 4-Card Telemetry & Health Grid -->
                <Grid Grid.Row="2" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource SurfaceLevel2Brush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="POLL RATE" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock x:Name="PollRateText" Text="250 Hz" FontSize="18" FontWeight="Bold" Foreground="{StaticResource StatusSuccessBrush}" Margin="0,2,0,0"/>
                            <TextBlock Text="Target: ≥ 250 Hz" FontSize="9" Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="{StaticResource SurfaceLevel2Brush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="3,0,3,0">
                        <StackPanel>
                            <TextBlock Text="ANGULAR VEL" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock x:Name="AngularVelText" Text="0.00 rad/s" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentCreamBrush}" Margin="0,2,0,0"/>
                            <TextBlock Text="Live gyro magnitude" FontSize="9" Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="{StaticResource SurfaceLevel2Brush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="3,0,3,0">
                        <StackPanel>
                            <TextBlock Text="GRAVITY VECTOR" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock x:Name="GravityVectorText" Text="1.000 G" FontSize="18" FontWeight="Bold" Foreground="{StaticResource StatusSuccessBrush}" Margin="0,2,0,0"/>
                            <TextBlock Text="Baseline: ~1.00 G" FontSize="9" Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Background="{StaticResource SurfaceLevel2Brush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="6,0,0,0">
                        <StackPanel>
                            <TextBlock Text="SENSOR HEALTH" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock x:Name="SensorHealthText" Text="OPTIMAL" FontSize="18" FontWeight="Bold" Foreground="{StaticResource StatusSuccessBrush}" Margin="0,2,0,0"/>
                            <TextBlock Text="Low drift floor" FontSize="9" Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Interactive Touchpad & Chord Shortcuts Reference Card -->
                <Border Grid.Row="3" Background="{StaticResource SurfaceLevel2Brush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Touchpad Visual Quad Box -->
                        <Border Grid.Column="0" Background="{StaticResource SurfaceLevel3Brush}" BorderBrush="{StaticResource BorderNormalBrush}"
                                BorderThickness="1" CornerRadius="6" Width="120" Height="74" Margin="0,0,16,0" VerticalAlignment="Center">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="DS4 TOUCHPAD" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                <Grid Grid.Row="1" Margin="6,3,6,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <Border x:Name="TouchQuadX" Grid.Row="0" Grid.Column="0" Margin="1" CornerRadius="2" Background="{StaticResource SurfaceLevel4Brush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                        <TextBlock Text="X (Top-L)" FontSize="8" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="TouchQuadY" Grid.Row="0" Grid.Column="1" Margin="1" CornerRadius="2" Background="{StaticResource SurfaceLevel4Brush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                        <TextBlock Text="Y (Top-R)" FontSize="8" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="TouchQuadA" Grid.Row="1" Grid.Column="0" Margin="1" CornerRadius="2" Background="{StaticResource SurfaceLevel4Brush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                        <TextBlock Text="A (Btm-L)" FontSize="8" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="TouchQuadB" Grid.Row="1" Grid.Column="1" Margin="1" CornerRadius="2" Background="{StaticResource SurfaceLevel4Brush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                        <TextBlock Text="B (Btm-R)" FontSize="8" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Shortcuts Cheatsheet -->
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="TOUCHPAD CHORDS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCreamBrush}" Margin="0,0,0,3"/>
                                <TextBlock Text="• Back + X / B / Y / A: Touchpad quadrant clicks" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="• Back (short press): Touchpad center click" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="GESTURES &amp; MOTION" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCreamBrush}" Margin="0,0,0,3"/>
                                <TextBlock Text="• Back + Right Stick: Directional swipe gestures" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="• L3 + R3 (simultaneous): Toggle Gyro ON/OFF" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ======================= RIGHT: CONTROLS, HARDWARE SENSOR & DSU BRIDGE ======================= -->
        <Border Grid.Column="1" Background="{StaticResource SurfaceLevel1Brush}"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Master Shunt Mode Switch Card -->
                    <Border Background="{StaticResource SurfaceLevel2Brush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="RUNTIME CONTROL" Style="{StaticResource SectionHeaderText}" Margin="0,0,0,8"/>
                            <DockPanel Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="MasterStatusDot" Width="10" Height="10" Fill="{StaticResource BorderNormalBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="MasterStatusText" Text="SHUNT MODE: DISABLED" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="GyroStreamBadge" DockPanel.Dock="Right" Text="GYRO: IDLE" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                            </DockPanel>

                            <Button x:Name="MasterShuntButton" Style="{StaticResource PrimaryButton}" Content="Enable Shunt Mode"
                                    Height="32" Click="MasterShuntButton_Click"/>
                            <TextBlock x:Name="MasterHelpText" Text="Routes physical Xbox controller inputs to a virtual DualShock 4 with native IMU motion reports."
                                       FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Hardware Motion Sensor Selection -->
                    <Border Background="{StaticResource SurfaceLevel2Brush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="HARDWARE IMU SENSOR" Style="{StaticResource SectionHeaderText}" VerticalAlignment="Center"/>
                                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="↻ Refresh" Padding="8,2" FontSize="10" Click="OnRefreshDevicesClick"/>
                            </DockPanel>

                            <ComboBox x:Name="ImuDeviceCombo" Style="{StaticResource DarkComboBox}" ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                                      DisplayMemberPath="DisplayName" SelectionChanged="OnImuDeviceSelectionChanged" Margin="0,4,0,8"/>

                            <Border Background="{StaticResource SurfaceLevel3Brush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="10,8">
                                <StackPanel>
                                    <TextBlock x:Name="ImuDeviceNameText" Text="GameSir G7 SE / Cyclone / Nova" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock x:Name="ImuDeviceDetailsText" Text="VID 0x3537 · PID 0x1004 · Report ID 0x01 (Direct HID IMU)" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                    <TextBlock x:Name="ImuDeviceSupportText" Text="Supported IMUs verified against hardware protocol parser" FontSize="9" Foreground="{StaticResource StatusSuccessBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Mode Hint Notice Banner -->
                            <Border x:Name="TunerNoticeBorder" Background="#2E2616" BorderBrush="#E6A23C" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,8,0,0" Visibility="Collapsed">
                                <DockPanel LastChildFill="True">
                                    <TextBlock Text="⚠️" FontSize="13" VerticalAlignment="Top" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="TunerNoticeText" Text="Mode notice" FontSize="9" Foreground="#FFE795" TextWrapping="Wrap"/>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- GameSir G7 Pro Onboard Chip Flash -->
                    <Border Background="{StaticResource SurfaceLevel2Brush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="GAMESIR G7 PRO ONBOARD CHIP FLASH" Style="{StaticResource SectionHeaderText}" VerticalAlignment="Center"/>
                            </DockPanel>

                            <TextBlock Text="Write the motion configuration directly into the GameSir G7 Pro's hardware chip (EEPROM). Eliminates any need to open the GameSir Nexus app."
                                       FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="TARGET STICK" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                    <ComboBox x:Name="ChipTargetStickCombo" Style="{StaticResource DarkComboBox}" ItemContainerStyle="{StaticResource DarkComboBoxItem}">
                                        <ComboBoxItem Content="Left Stick (Shunt Gyro)" IsSelected="True"/>
                                        <ComboBoxItem Content="Right Stick (Camera Aim)"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                    <TextBlock Text="ACTIVATION" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                    <ComboBox x:Name="ChipActivationCombo" Style="{StaticResource DarkComboBox}" ItemContainerStyle="{StaticResource DarkComboBoxItem}">
                                        <ComboBoxItem Content="Always Active (Hardware)" IsSelected="True"/>
                                        <ComboBoxItem Content="Trigger Key (Hold to Aim)"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <CheckBox x:Name="AutoSyncChipCheckBox" Content="Auto-sync chip on L3+R3 toggle (Gyro active only in Shunt)"
                                      IsChecked="True" Checked="AutoSyncChipCheckBox_Changed" Unchecked="AutoSyncChipCheckBox_Changed"
                                      Foreground="{StaticResource TextPrimaryBrush}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,8"/>

                            <Button x:Name="FlashChipButton" Style="{StaticResource SecondaryButton}" Content="⚡ Write Gyro to Controller Chip"
                                    Height="30" Click="FlashChipButton_Click"/>

                            <ProgressBar x:Name="FlashProgressBar" Height="4" Margin="0,6,0,0" Visibility="Collapsed"
                                         Background="{StaticResource SurfaceLevel3Brush}" Foreground="{StaticResource AccentCreamBrush}" Minimum="0" Maximum="100"/>

                            <TextBlock x:Name="FlashStatusText" Text="Ready to program GameSir MCU flash."
                                       FontSize="9" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Activation Mode -->
                    <Border Background="{StaticResource SurfaceLevel2Brush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="ACTIVATION MODE" Style="{StaticResource SectionHeaderText}" Margin="0,0,0,6"/>
                            <ComboBox x:Name="ActivationModeCombo" Style="{StaticResource DarkComboBox}" ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                                      SelectionChanged="OnActivationModeChanged" Margin="0,0,0,8">
                                <ComboBoxItem Content="Toggle Mode (L3 + R3 shortcut)" IsSelected="True"/>
                                <ComboBoxItem Content="Hold Mode (Aim / Left Trigger)"/>
                                <ComboBoxItem Content="Always Active (Continuous Motion)"/>
                            </ComboBox>
                            <TextBlock Text="Toggle allows engaging gyro for precision aim and pausing when recentering hands."
                                       FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Virtual DualShock 4 & DSU Protocol Bridge -->
                    <Border Background="{StaticResource SurfaceLevel2Brush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="TARGET &amp; DSU SERVER" Style="{StaticResource SectionHeaderText}" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="ViGEm DualShock 4 Target" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Direct Raw Motion &amp; Touch Packets" FontSize="9" Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{StaticResource SurfaceLevel3Brush}" CornerRadius="3" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock x:Name="ViGEmStatusText" Text="READY" FontSize="9" FontWeight="Bold" Foreground="{StaticResource StatusSuccessBrush}"/>
                                </Border>
                            </Grid>

                            <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="0,6,0,6"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Cemuhook / DSU Protocol Server" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="UDP Port 26760 (ShadPS4 / Cemu)" FontSize="9" Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                                <Button x:Name="DsuServerToggleBtn" Content="Enable DSU" Padding="8,3" FontSize="10"
                                        Style="{StaticResource SecondaryButton}" Click="OnDsuServerToggleClick"/>
                            </Grid>

                            <TextBlock Text="Tested games: Bloodborne, Driveclub, The Last of Us Remastered."
                                       FontSize="9" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Diagnostic & Calibration Actions -->
                    <Border Background="{StaticResource SurfaceLevel2Brush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="14">
                        <StackPanel>
                            <TextBlock Text="DIAGNOSTICS &amp; CALIBRATION" Style="{StaticResource SectionHeaderText}" Margin="0,0,0,8"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="🎯 Run Gyro ShadPS4 Wizard" Margin="0,0,0,8"
                                    Click="OnLaunchWizardClick"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="Zero Drift Baseline"
                                    Click="OnZeroCalibrationClick"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
