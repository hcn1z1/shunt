<UserControl x:Class="Shunt.UI.Views.Macro.MacroTimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="900">
    <Grid Background="{StaticResource CanvasBackgroundBrush}" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header & Action Bar -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Macro &amp; Combo Timeline Sequencer" Style="{StaticResource SectionHeaderText}"/>
                <Border Background="{StaticResource SurfaceLevel3Brush}" CornerRadius="10" Padding="8,2" Margin="12,0,0,0">
                    <TextBlock Text="1ms High-Precision Timer" Style="{StaticResource BodyMutedText}"/>
                </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="+ Add Button" Style="{StaticResource SecondaryButton}" Margin="4,0" Click="OnAddButtonStep"/>
                <Button Content="+ Add Delay" Style="{StaticResource SecondaryButton}" Margin="4,0" Click="OnAddDelayStep"/>
                <Button Content="+ Add Rumble" Style="{StaticResource SecondaryButton}" Margin="4,0" Click="OnAddRumbleStep"/>
                <Button Content="Clear All" Style="{StaticResource SecondaryButton}" Margin="4,0" Click="OnClearSteps"/>
                <Button Content="▶ Test Run" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="OnTestRun"/>
            </StackPanel>
        </DockPanel>

        <!-- Ruler (Time axis) -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceLevel2Brush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1,1,1,0" CornerRadius="6,6,0,0" Height="28">
            <Canvas x:Name="RulerCanvas">
                <TextBlock Text="0ms" Canvas.Left="10" Canvas.Top="6" Style="{StaticResource BodyMutedText}"/>
                <TextBlock Text="100ms" Canvas.Left="150" Canvas.Top="6" Style="{StaticResource BodyMutedText}"/>
                <TextBlock Text="200ms" Canvas.Left="300" Canvas.Top="6" Style="{StaticResource BodyMutedText}"/>
                <TextBlock Text="300ms" Canvas.Left="450" Canvas.Top="6" Style="{StaticResource BodyMutedText}"/>
                <TextBlock Text="400ms" Canvas.Left="600" Canvas.Top="6" Style="{StaticResource BodyMutedText}"/>
                <TextBlock Text="500ms" Canvas.Left="750" Canvas.Top="6" Style="{StaticResource BodyMutedText}"/>
            </Canvas>
        </Border>

        <!-- Multi-track sequencer view -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceLevel1Brush}"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="0,0,6,6" Padding="12">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Track 1: Gamepad Buttons Track -->
                    <Border Background="{StaticResource SurfaceLevel2Brush}" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Gamepad Buttons" Style="{StaticResource BodyBoldText}" VerticalAlignment="Center"/>
                            <ItemsControl Grid.Column="1" x:Name="ButtonTrackItems">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <!-- Track 2: Delay & Timing Track -->
                    <Border Background="{StaticResource SurfaceLevel2Brush}" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Delays (Wait)" Style="{StaticResource BodyBoldText}" VerticalAlignment="Center"/>
                            <ItemsControl Grid.Column="1" x:Name="DelayTrackItems">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <!-- Track 3: Rumble / Feedback Track -->
                    <Border Background="{StaticResource SurfaceLevel2Brush}" CornerRadius="4" Padding="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Haptics / Rumble" Style="{StaticResource BodyBoldText}" VerticalAlignment="Center"/>
                            <ItemsControl Grid.Column="1" x:Name="RumbleTrackItems">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Footer / Loop Configuration -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceLevel2Brush}" CornerRadius="6" Padding="12" Margin="0,12,0,0">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Loop Mode:" Style="{StaticResource BodyBoldText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="LoopModeCombo" Width="180" Margin="0,0,16,0">
                        <ComboBoxItem Content="Play Once (No Loop)" IsSelected="True"/>
                        <ComboBoxItem Content="Repeat 2 Times"/>
                        <ComboBoxItem Content="Repeat 5 Times"/>
                        <ComboBoxItem Content="Loop Until Released"/>
                    </ComboBox>

                    <TextBlock Text="Interrupt on Release:" Style="{StaticResource BodyText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <CheckBox IsChecked="True" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock x:Name="TimelineStatusText" Text="Timeline: 4 steps (Total duration: 350ms)"
                           Style="{StaticResource BodyMutedText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
