<UserControl x:Class="Shunt.UI.Views.Workspace.GamepadCanvasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Sub-mode and Shift layer bar -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceLevel1Brush}"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="10,6">
            <Grid>
                <!-- Left: Shift Layers -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="LAYER" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,8,0"/>
                    <RadioButton x:Name="ShiftMainPill" Style="{StaticResource SlotPill}" GroupName="CanvasShift"
                                 Content="Main" IsChecked="True" Checked="ShiftPill_Checked" Tag="0" ToolTip="Main layer (Shift 0)"/>
                    <RadioButton x:Name="ShiftS1Pill" Style="{StaticResource SlotPill}" GroupName="CanvasShift" Content="S1"
                                 Checked="ShiftPill_Checked" Tag="1" ToolTip="Shift layer 1"/>
                    <RadioButton x:Name="ShiftS2Pill" Style="{StaticResource SlotPill}" GroupName="CanvasShift" Content="S2"
                                 Checked="ShiftPill_Checked" Tag="2" ToolTip="Shift layer 2"/>
                    <RadioButton x:Name="ShiftS3Pill" Style="{StaticResource SlotPill}" GroupName="CanvasShift" Content="S3"
                                 Checked="ShiftPill_Checked" Tag="3" ToolTip="Shift layer 3"/>
                    <RadioButton x:Name="ShiftS4Pill" Style="{StaticResource SlotPill}" GroupName="CanvasShift" Content="S4"
                                 Checked="ShiftPill_Checked" Tag="4" ToolTip="Shift layer 4"/>

                    <Border Width="1" Height="16" Background="{StaticResource BorderSubtleBrush}" Margin="12,0,12,0"/>

                    <!-- Sub-mode Selector: Gamepad / DS4 Touchpad / Motion & Gyro -->
                    <TextBlock Text="SENSOR / CONTROLS" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,8,0"/>
                    <RadioButton x:Name="SubmodeGamepad" Style="{StaticResource SlotPill}" GroupName="CanvasSubmode"
                                 Content="🎮 Gamepad" IsChecked="True" Checked="SubmodePill_Checked" Tag="gamepad"
                                 ToolTip="Standard Gamepad Buttons (Xbox / PS / Switch)"/>
                    <RadioButton x:Name="SubmodeTouchpad" Style="{StaticResource SlotPill}" GroupName="CanvasSubmode"
                                 Content="👆 DS4 Touchpad" Checked="SubmodePill_Checked" Tag="touchpad"
                                 ToolTip="DualShock 4 Touchpad Gestures: Tap, Click, Swipes (Up/Down/Left/Right)"/>
                    <RadioButton x:Name="SubmodeGyro" Style="{StaticResource SlotPill}" GroupName="CanvasSubmode"
                                 Content="🎯 Motion / Gyro" Checked="SubmodePill_Checked" Tag="gyro"
                                 ToolTip="Virtual Gyroscope (VGYRO) &amp; Motion Tilts (Left/Right/Up/Down)"/>
                </StackPanel>

                <!-- Right: Toggles -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- Live Input Glow option toggle -->
                    <ToggleButton x:Name="InputGlowToggle" IsChecked="True" Click="InputGlowToggle_Click"
                                  Cursor="Hand" ToolTip="Live Controller Visualizer: Physical button presses glow on the controller figure in real time"
                                  Margin="0,0,10,0">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Bd" Background="{StaticResource SurfaceLevel2Brush}" CornerRadius="4"
                                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Padding="10,5">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{StaticResource StatusSuccessBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="Lbl" Text="Input Glow: ON" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="False">
                                        <Setter TargetName="Dot" Property="Fill" Value="{StaticResource TextMutedBrush}"/>
                                        <Setter TargetName="Lbl" Property="Text" Value="Input Glow: OFF"/>
                                        <Setter TargetName="Lbl" Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource StatusSuccessBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>

                    <!-- Flip Front/Back -->
                    <ToggleButton x:Name="FlipToggle" Click="FlipToggle_Click"
                                  Cursor="Hand" ToolTip="Flip controller front/back (Ctrl+F)">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Bd" Background="{StaticResource SurfaceLevel2Brush}" CornerRadius="4"
                                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Padding="12,5">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M 3 6 A 7 7 0 1 1 5 11" Stroke="{StaticResource TextSecondaryBrush}"
                                              StrokeThickness="1.4" Width="14" Height="14" Stretch="Uniform"/>
                                        <TextBlock x:Name="Lbl" Text="Flip: Front" Margin="7,0,0,0" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Lbl" Property="Text" Value="Flip: Back"/>
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderFocusedBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                </StackPanel>
            </Grid>
        </Border>

