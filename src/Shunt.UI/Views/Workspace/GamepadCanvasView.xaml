                    <TextBlock Grid.Row="0" Grid.Column="0" Text="X" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#9AA4B2" FontSize="10"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Y" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#9AA4B2" FontSize="10"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="A" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#9AA4B2" FontSize="10"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="B" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#9AA4B2" FontSize="10"/>
                </Grid>
                <TextBlock x:Name="ShuntTouchAction" Text="Back + face: touchpad click" FontSize="10"
