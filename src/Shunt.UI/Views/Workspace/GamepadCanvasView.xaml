        <!-- Live Vibration Feedback Toast (plan 07 §6, UI Phase 4) -->
        <Border x:Name="VibrationToast" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,24" Background="#E61A222D" BorderBrush="#81CF66" BorderThickness="1.5"
                CornerRadius="20" Padding="14,6" Visibility="Collapsed" IsHitTestVisible="False"
                Opacity="0">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="2" Opacity="0.5"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="📳" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="VibrationToastText" Text="Haptic Feedback"
                           FontSize="12" FontWeight="SemiBold" Foreground="#81CF66" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Shunt Mode live HUD (phase 3) -->
        <Border x:Name="ShuntHud" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,20,20" Padding="14,12" CornerRadius="10"
                Background="#E61A222D" BorderBrush="#6681CF66" BorderThickness="1"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="2" Opacity="0.4"/>
            </Border.Effect>
            <StackPanel MinWidth="230">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Ellipse x:Name="ShuntActiveDot" Width="8" Height="8" Fill="#81CF66"
                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="SHUNT MODE: ACTIVE" FontWeight="Bold" FontSize="12" Foreground="#81CF66"/>
                </StackPanel>
                <TextBlock x:Name="ShuntGyroStatus" Text="GYRO: PAUSED" FontSize="11"
                           Foreground="#C7CDD5" Margin="0,0,0,8"/>
                <Grid Width="90" Height="54" HorizontalAlignment="Left" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <Border x:Name="ShuntTouchLeftTop" Grid.Row="0" Grid.Column="0" Margin="1" CornerRadius="3" Background="#332B3542" BorderBrush="#66515C6A" BorderThickness="1"/>
                    <Border x:Name="ShuntTouchRightTop" Grid.Row="0" Grid.Column="1" Margin="1" CornerRadius="3" Background="#332B3542" BorderBrush="#66515C6A" BorderThickness="1"/>
                    <Border x:Name="ShuntTouchLeftBottom" Grid.Row="1" Grid.Column="0" Margin="1" CornerRadius="3" Background="#332B3542" BorderBrush="#66515C6A" BorderThickness="1"/>
