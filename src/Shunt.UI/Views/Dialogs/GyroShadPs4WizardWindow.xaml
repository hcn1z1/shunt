<Window x:Class="Shunt.UI.Views.Dialogs.GyroShadPs4WizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gyro ShadPS4 Diagnostic Wizard" Width="680" Height="640"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource CanvasBackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource BrandFontFamily}"
        WindowStyle="None">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/> <!-- Custom Dark Title Bar -->
                <RowDefinition Height="*"/>  <!-- Main Dialog Body -->
            </Grid.RowDefinitions>

            <!-- Custom Dark Title Bar -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceLevel1Brush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="True">
                    <Button Content="✕" DockPanel.Dock="Right" Style="{StaticResource WindowButton}" Click="CloseButton_Click"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="🎯" FontSize="14" Foreground="{StaticResource AccentCreamBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Gyro ShadPS4 Diagnostic Wizard" Style="{StaticResource BodyBoldText}" VerticalAlignment="Center"/>
                        <TextBlock Text="— Hardware Motion Verification" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Dialog Body -->
            <Grid Grid.Row="1" Margin="20,16,20,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Device Summary Banner -->
                    <RowDefinition Height="*"/>    <!-- 3D Gimbal Visualizer -->
                    <RowDefinition Height="Auto"/> <!-- Telemetry Cards -->
                    <RowDefinition Height="Auto"/> <!-- Verdict Banner -->
                    <RowDefinition Height="Auto"/> <!-- Footer Actions -->
                </Grid.RowDefinitions>

                <!-- Device Summary Banner & Mode Notice -->
                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <Border Background="{StaticResource SurfaceLevel1Brush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8"
                            Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Hardware Device" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="DeviceDetailsText" Text="Secondary HID Endpoint (1000Hz)" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <ComboBox x:Name="DeviceCombo" Grid.Column="1" Height="32" DisplayMemberPath="DisplayName"
                                      Style="{StaticResource DarkComboBox}" ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                                      VerticalAlignment="Center" SelectionChanged="DeviceCombo_SelectionChanged"/>
                            <Button x:Name="RescanButton" Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="🔄 Rescan"
                                    Padding="8,4" Margin="8,0,0,0" VerticalAlignment="Center" Click="RescanButton_Click"
                                    ToolTip="Rescan for connected motion controllers."/>
                            <Border Grid.Column="3" Background="{StaticResource SurfaceLevel2Brush}" BorderBrush="{StaticResource BorderNormalBrush}" BorderThickness="1"
                                    CornerRadius="4" Padding="8,4" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="ConnectionBadge" Text="USB 2.0 Motion Stream" FontSize="10"
                                           Foreground="{StaticResource AccentCreamBrush}" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Controller Hardware Mode Notice (e.g. GameSir G7 Pro in Xbox mode) -->
                    <Border x:Name="DeviceNoticeBorder" Background="#2E2616" BorderBrush="#E6A23C" BorderThickness="1" CornerRadius="8"
                            Padding="12,8" Margin="0,8,0,0" Visibility="Collapsed">
                        <DockPanel LastChildFill="True">
                            <TextBlock Text="⚠️" FontSize="15" VerticalAlignment="Top" Margin="0,1,10,0"/>
                            <StackPanel>
                                <TextBlock Text="Controller Hardware Mode Notice" FontSize="11" FontWeight="Bold" Foreground="#FFE795" Margin="0,0,0,2"/>
                                <TextBlock x:Name="DeviceNoticeText" Text="GameSir G7 Pro notice..." FontSize="10" Foreground="#FFE795" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- Interactive 3D Gimbal Horizon Visualizer -->
                <Border Grid.Row="1" Background="{StaticResource SurfaceLevel1Brush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8"
                        Margin="0,0,0,14" ClipToBounds="True">
                    <Grid>
                        <!-- Live Input & Slot Overlay in Top-Left Corner of Horizon Box -->
                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,12,0,0" Panel.ZIndex="10">
                            <TextBlock x:Name="SlotStatusText" Text="Slot: Detecting..." FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentCreamBrush}" Margin="0,0,0,2"/>
                            <TextBlock x:Name="StickStatusText" Text="Sticks: Resting (0, 0)" FontSize="10"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>

                        <Canvas x:Name="GimbalCanvas" ClipToBounds="True" Height="190" VerticalAlignment="Top">
                            <!-- Outer Gimbal Circle -->
                            <Ellipse Width="170" Height="170" Stroke="{StaticResource BorderStrongBrush}" StrokeThickness="2"
                                     Canvas.Left="231" Canvas.Top="10"/>
                            <Ellipse Width="80" Height="80" Stroke="{StaticResource BorderSubtleBrush}" StrokeThickness="1"
                                     Canvas.Left="276" Canvas.Top="55"/>
                            <!-- Pitch reference marks -->
                            <Line X1="306" Y1="70" X2="326" Y2="70" Stroke="{StaticResource BorderNormalBrush}" StrokeThickness="1.5"/>
                            <Line X1="306" Y1="120" X2="326" Y2="120" Stroke="{StaticResource BorderNormalBrush}" StrokeThickness="1.5"/>
                            <!-- Center Crosshair Pip -->
                            <Ellipse Width="6" Height="6" Fill="{StaticResource AccentCreamBrush}" Canvas.Left="313" Canvas.Top="92"/>
                            <!-- Dynamic Artificial Horizon Line -->
                            <Line x:Name="HorizonLine" X1="160" Y1="95" X2="472" Y2="95"
                                  Stroke="{StaticResource AccentCreamBrush}" StrokeThickness="2.5" RenderTransformOrigin="0.5,0.5">
                                <Line.RenderTransform>
                                    <TransformGroup>
                                        <RotateTransform x:Name="HorizonRotate" Angle="0"/>
                                        <TranslateTransform x:Name="HorizonTranslate" Y="0"/>
                                    </TransformGroup>
                                </Line.RenderTransform>
                            </Line>
                        </Canvas>

                        <!-- Live Angles Overlay in Top-Right Corner of Horizon Box -->
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,16,0" Panel.ZIndex="10">
                            <TextBlock x:Name="PitchText" Text="Pitch: 0.0°" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentCreamBrush}" HorizontalAlignment="Right" Margin="0,0,0,2"/>
                            <TextBlock x:Name="RollText" Text="Roll: 0.0°" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentCreamBrush}" HorizontalAlignment="Right" Margin="0,0,0,2"/>
                            <TextBlock x:Name="YawText" Text="Yaw: 0.0°/s" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentCreamBrush}" HorizontalAlignment="Right"/>
                        </StackPanel>

                        <!-- Visualizer Bottom Prompt & Progress -->
                        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <TextBlock x:Name="PromptText" Text="Tilt controller gently in all directions…"
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            <ProgressBar x:Name="TestProgressBar" Width="320" Height="6" Margin="0,8,0,0"
                                         Foreground="{StaticResource AccentCreamBrush}" Background="{StaticResource SurfaceLevel3Brush}" BorderThickness="0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Telemetry Cards -->
                <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,14">
                    <Border Background="{StaticResource SurfaceLevel2Brush}" CornerRadius="6" Padding="10,8" Margin="0,0,4,0" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="POLL RATE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock x:Name="RateText" Text="— Hz" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource SurfaceLevel2Brush}" CornerRadius="6" Padding="10,8" Margin="4,0,4,0" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="ANGULAR VEL" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock x:Name="MotionText" Text="— °/s" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource SurfaceLevel2Brush}" CornerRadius="6" Padding="10,8" Margin="4,0,4,0" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="GRAVITY (1G)" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock x:Name="GravityText" Text="— G" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource SurfaceLevel2Brush}" CornerRadius="6" Padding="10,8" Margin="4,0,0,0" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="NOISE FLOOR" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock x:Name="NoiseText" Text="— °/s" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Verdict Banner -->
                <Border x:Name="VerdictBorder" Grid.Row="3" Background="{StaticResource SurfaceLevel2Brush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="12,8" Margin="0,0,0,16" Visibility="Visible">
                    <TextBlock x:Name="StatusText" Text="Ready: Press 'Run 3-second test' to begin hardware motion verification."
                               Foreground="{StaticResource AccentCreamBrush}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </Border>

                <!-- Footer Actions -->
                <Grid Grid.Row="4">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <ComboBox x:Name="ActivationModeCombo" Width="180" Height="34" SelectedIndex="0"
                                  Style="{StaticResource DarkComboBox}" ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                                  ToolTip="Choose whether L3 + R3 toggles gyro or holds it on.">
                            <ComboBoxItem Content="Toggle with L3 + R3"/>
                            <ComboBoxItem Content="Hold L3 + R3"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="FlashChipButton" Style="{StaticResource SecondaryButton}" Content="⚡ Flash GameSir Chip"
                                Padding="12,6" Margin="0,0,10,0" Click="FlashChipButton_Click"/>
                        <Button x:Name="TestButton" Style="{StaticResource SecondaryButton}" Content="▶ Run 3-second test"
                                Padding="14,6" Margin="0,0,10,0" Click="TestButton_Click"/>
                        <Button x:Name="EnableShuntButton" Style="{StaticResource PrimaryButton}" Content="⚡ Enable Shunt Mode"
                                IsEnabled="False" Width="170" Padding="12,6" Margin="0,0,10,0" Click="EnableShuntButton_Click"/>
                        <Button Content="Close" Style="{StaticResource SecondaryButton}" Width="80" Padding="10,6" Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
