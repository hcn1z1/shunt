<Window x:Class="Shunt.UI.Views.Dialogs.GyroShadPs4WizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gyro ShadPS4" Width="620" Height="470"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#11151B" Foreground="#E8EDF2">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Gyro ShadPS4" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="Check whether this controller exposes a usable six-axis motion sensor." Foreground="#A8B2BE" Margin="0,5,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Sensor interface" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <ComboBox x:Name="DeviceCombo" Grid.Column="1" Height="34" DisplayMemberPath="Profile.Name"
                      Background="#222A34" Foreground="#E8EDF2" SelectionChanged="DeviceCombo_SelectionChanged"/>
            <Button x:Name="TestButton" Grid.Column="2" Content="Run 3-second test" Margin="10,0,0,0" Padding="14,6"
                    Click="TestButton_Click" Background="#00A9C7" Foreground="White" BorderThickness="0"/>
        </Grid>
        <Border Grid.Row="2" Background="#1A2028" BorderBrush="#303A46" BorderThickness="1" CornerRadius="8" Padding="18">
            <StackPanel>
                <TextBlock x:Name="StatusText" Text="Keep the controller still briefly, then tilt it in all directions." TextWrapping="Wrap" FontSize="14" Margin="0,0,0,15"/>
                <ProgressBar x:Name="ProgressBar" Height="8" Minimum="0" Maximum="100"/>
                <TextBlock x:Name="StageText" Text="Ready" Foreground="#A8B2BE" Margin="0,8,0,16"/>
                <UniformGrid Columns="2" Rows="2">
                    <TextBlock x:Name="RateText" Text="Polling rate: —" Margin="0,6"/>
                    <TextBlock x:Name="MotionText" Text="Angular range: —" Margin="0,6"/>
                    <TextBlock x:Name="GravityText" Text="Gravity: —" Margin="0,6"/>
                    <TextBlock x:Name="NoiseText" Text="Noise floor: —" Margin="0,6"/>
                </UniformGrid>
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Close" Width="100" Padding="10,6" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
