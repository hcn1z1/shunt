<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Background Surfaces -->
    <Color x:Key="CanvasBackground">#1F1F1F</Color>
    <Color x:Key="SurfaceLevel1">#252525</Color>
    <Color x:Key="SurfaceLevel2">#2B2B2B</Color>
    <Color x:Key="SurfaceLevel3">#303030</Color>
    <Color x:Key="SurfaceLevel4">#363636</Color>
    <Color x:Key="SurfaceElevated">#3E3E3E</Color>
    <Color x:Key="SurfacePopup">#282828</Color>

    <!-- Borders & Dividers -->
    <Color x:Key="BorderSubtle">#3A3A3A</Color>
    <Color x:Key="BorderNormal">#494949</Color>
    <Color x:Key="BorderStrong">#5A5A5A</Color>
    <Color x:Key="BorderFocused">#FFE795</Color>

    <!-- Brush projections of the surface / border palette -->
    <SolidColorBrush x:Key="CanvasBackgroundBrush" Color="{StaticResource CanvasBackground}"/>
    <SolidColorBrush x:Key="SurfaceLevel1Brush" Color="{StaticResource SurfaceLevel1}"/>
    <SolidColorBrush x:Key="SurfaceLevel2Brush" Color="{StaticResource SurfaceLevel2}"/>
    <SolidColorBrush x:Key="SurfaceLevel3Brush" Color="{StaticResource SurfaceLevel3}"/>
    <SolidColorBrush x:Key="SurfaceLevel4Brush" Color="{StaticResource SurfaceLevel4}"/>
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevated}"/>
    <SolidColorBrush x:Key="SurfacePopupBrush" Color="{StaticResource SurfacePopup}"/>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtle}"/>
    <SolidColorBrush x:Key="BorderNormalBrush" Color="{StaticResource BorderNormal}"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrong}"/>
    <SolidColorBrush x:Key="BorderFocusedBrush" Color="{StaticResource BorderFocused}"/>

    <!-- Text & Typography Brushes -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#CACACA"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#868686"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#555555"/>
    <SolidColorBrush x:Key="TextContrastBrush" Color="#1F1F1F"/>

    <!-- Primary Brand Accent (Cream / Gold) -->
    <SolidColorBrush x:Key="AccentCreamBrush" Color="#FFE795"/>
    <SolidColorBrush x:Key="AccentCreamHoverBrush" Color="#FFF1BF"/>
    <SolidColorBrush x:Key="AccentCreamPressedBrush" Color="#F6DC85"/>
    <SolidColorBrush x:Key="AccentCreamSubtleBrush" Color="#33FFE795"/>

    <!-- Status & Functional Telemetry -->
    <SolidColorBrush x:Key="StatusSuccessBrush" Color="#81CF66"/>  <!-- Remap Active LED -->
    <SolidColorBrush x:Key="StatusSuccessGlowBrush" Color="#4DC81F"/>
    <SolidColorBrush x:Key="StatusErrorBrush" Color="#FF5555"/>    <!-- Conflict / Unmapped -->
    <SolidColorBrush x:Key="StatusWarningBrush" Color="#FF6D40"/>  <!-- Battery Low / Warning -->
    <SolidColorBrush x:Key="StatusInfoBrush" Color="#5BB7FF"/>     <!-- USB Connected -->

    <!-- Multi-Shift Layer Identity Colors -->
    <SolidColorBrush x:Key="Shift0Brush" Color="#FFE795"/>         <!-- Main Layer (Gold) -->
    <SolidColorBrush x:Key="Shift1Brush" Color="#FFBE8A"/>         <!-- Shift 1: Pastel Apricot -->
    <SolidColorBrush x:Key="Shift2Brush" Color="#BCE492"/>         <!-- Shift 2: Lime Herb -->
    <SolidColorBrush x:Key="Shift3Brush" Color="#A6D9DF"/>         <!-- Shift 3: Pale Cyan -->
    <SolidColorBrush x:Key="Shift4Brush" Color="#D2BAE8"/>         <!-- Shift 4: Soft Lavender -->

    <!-- Typography -->
    <!-- Barlow / Roboto Condensed fall back to Segoe UI until the font assets are embedded. -->
    <FontFamily x:Key="BrandFontFamily">Barlow, Segoe UI, Arial</FontFamily>
    <FontFamily x:Key="TelemetryFontFamily">Roboto Condensed, Consolas, Segoe UI</FontFamily>

    <Style x:Key="WindowTitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BrandFontFamily}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>
    <Style x:Key="SectionHeaderText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BrandFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>
    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BrandFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    </Style>
    <Style x:Key="BodyBoldText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BrandFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>
    <Style x:Key="BodyMutedText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BrandFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
    </Style>
    <Style x:Key="BadgeLabelText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BrandFontFamily}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>
    <Style x:Key="TelemetryText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TelemetryFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    </Style>
    <Style x:Key="KeyCapText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TelemetryFontFamily}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

</ResourceDictionary>
