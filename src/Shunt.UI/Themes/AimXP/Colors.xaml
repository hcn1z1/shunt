<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- AimXP (Cyberpunk High-Contrast Theme): Deep Midnight Backgrounds -->
    <Color x:Key="CanvasBackground">#011349</Color>
    <Color x:Key="SurfaceLevel1">#052142</Color>
    <Color x:Key="SurfaceLevel2">#042A4A</Color>
    <Color x:Key="SurfaceLevel3">#0E335E</Color>
    <Color x:Key="SurfaceLevel4">#143D6F</Color>
    <Color x:Key="SurfaceElevated">#191B2B</Color>
    <Color x:Key="SurfacePopup">#052142</Color>

    <!-- Borders & Dividers -->
    <Color x:Key="BorderSubtle">#133A6B</Color>
    <Color x:Key="BorderNormal">#1E4E8A</Color>
    <Color x:Key="BorderStrong">#2D6AA8</Color>
    <Color x:Key="BorderFocused">#82EAFF</Color>

    <!-- Brush projections of the surface / border palette -->
    <SolidColorBrush x:Key="CanvasBackgroundBrush" Color="{StaticResource CanvasBackground}"/>
    <SolidColorBrush x:Key="SurfaceLevel1Brush" Color="{StaticResource SurfaceLevel1}"/>
    <SolidColorBrush x:Key="SurfaceLevel2Brush" Color="{StaticResource SurfaceLevel2}"/>
    <SolidColorBrush x:Key="SurfaceLevel3Brush" Color="{StaticResource SurfaceLevel3}"/>
    <SolidColorBrush x:Key="SurfaceLevel4Brush" Color="{StaticResource SurfaceLevel4}"/>
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevated}"/>
    <SolidColorBrush x:Key="SurfacePopupBrush" Color="{StaticResource SurfacePopup}"/>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtle}"/>
    <SolidColorBrush x:Key="BorderNormalBrush" Color="{StaticResource BorderNormal}"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrong}"/>
    <SolidColorBrush x:Key="BorderFocusedBrush" Color="{StaticResource BorderFocused}"/>

    <!-- Text & Typography Brushes -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#CDE6FD"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#769EC7"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#3A567D"/>
    <SolidColorBrush x:Key="TextContrastBrush" Color="#011349"/>

    <!-- Neon Accents -->
    <SolidColorBrush x:Key="AccentCreamBrush" Color="#82EAFF"/>
    <SolidColorBrush x:Key="AccentCreamHoverBrush" Color="#B2F2FF"/>
    <SolidColorBrush x:Key="AccentCreamPressedBrush" Color="#62DAFF"/>
    <SolidColorBrush x:Key="AccentCreamSubtleBrush" Color="#3382EAFF"/>

    <!-- Status telemetry keeps readable contrast on midnight surfaces -->
    <SolidColorBrush x:Key="StatusSuccessBrush" Color="#4DEE9E"/>
    <SolidColorBrush x:Key="StatusSuccessGlowBrush" Color="#1ED98A"/>
    <SolidColorBrush x:Key="StatusErrorBrush" Color="#FF5C7A"/>
    <SolidColorBrush x:Key="StatusWarningBrush" Color="#FF9E58"/>
    <SolidColorBrush x:Key="StatusInfoBrush" Color="#2F9AFF"/>

    <!-- Shift layer identity, neon-tinted -->
    <SolidColorBrush x:Key="Shift0Brush" Color="#82EAFF"/>
    <SolidColorBrush x:Key="Shift1Brush" Color="#973CFF"/>
    <SolidColorBrush x:Key="Shift2Brush" Color="#2F9AFF"/>
    <SolidColorBrush x:Key="Shift3Brush" Color="#4DEE9E"/>
    <SolidColorBrush x:Key="Shift4Brush" Color="#FF9E58"/>

    <!-- Typography -->
    <FontFamily x:Key="BrandFontFamily">Barlow, Segoe UI, Arial</FontFamily>
    <FontFamily x:Key="TelemetryFontFamily">Roboto Condensed, Consolas, Segoe UI</FontFamily>

    <Style x:Key="WindowTitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BrandFontFamily}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>
    <Style x:Key="SectionHeaderText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BrandFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>
    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BrandFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    </Style>
    <Style x:Key="BodyBoldText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BrandFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>
    <Style x:Key="BodyMutedText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BrandFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
    </Style>
    <Style x:Key="BadgeLabelText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BrandFontFamily}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>
    <Style x:Key="TelemetryText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TelemetryFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    </Style>
    <Style x:Key="KeyCapText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TelemetryFontFamily}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

</ResourceDictionary>
