<Window x:Class="Shunt.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Shunt.UI.Controls"
        xmlns:workspace="clr-namespace:Shunt.UI.Views.Workspace"
        xmlns:inspector="clr-namespace:Shunt.UI.Views.Inspector"
        xmlns:tuners="clr-namespace:Shunt.UI.Views.Tuners"
        xmlns:macro="clr-namespace:Shunt.UI.Views.Macro"
        xmlns:radial="clr-namespace:Shunt.UI.Views.Radial"
        xmlns:dialogs="clr-namespace:Shunt.UI.Views.Dialogs"
        Title="SHUNT - Open Buttons Router" Height="800" Width="1366" MinHeight="700" MinWidth="1100"
        Icon="Assets/icon.ico"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBackgroundBrush}"
        Foreground="{StaticResource TextSecondaryBrush}"
        FontFamily="{StaticResource BrandFontFamily}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        Loaded="Window_Loaded" Closing="Window_Closing" StateChanged="Window_StateChanged">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- DataGrid dark restyle -->
        <SolidColorBrush x:Key="GridRowHoverBrush" Color="#3333FFE795"/>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource SurfaceLevel1Brush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="{StaticResource SurfaceLevel1Brush}"/>
            <Setter Property="AlternatingRowBackground" Value="#292929"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderSubtleBrush}"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="RowHeight" Value="34"/>
            <Setter Property="FontFamily" Value="{StaticResource BrandFontFamily}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource SurfaceLevel3Brush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SurfaceLevel3Brush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource SurfaceLevel4Brush}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBar}"/>

        <!-- Game drawer tile -->
        <DataTemplate x:Key="GameTileTemplate">
            <Button Click="GameTile_Click" Cursor="Hand" Width="128" Margin="4,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Width="128" Height="104" CornerRadius="6"
                                Background="{StaticResource SurfaceLevel2Brush}"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="62"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="{StaticResource SurfaceLevel4Brush}" CornerRadius="6,6,0,0">
                                    <TextBlock Text="{Binding Initials}" FontSize="22" FontWeight="Black"
                                               Foreground="{StaticResource AccentCreamBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="10" TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,2"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderFocusedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>   <!-- HeaderZone / window caption -->
            <RowDefinition Height="Auto"/> <!-- Top drawer: games & configs grid -->
            <RowDefinition Height="*"/>    <!-- Main workspace: nav rail + stage -->
            <RowDefinition Height="64"/>   <!-- FooterZone: devices & actions -->
        </Grid.RowDefinitions>

        <!-- ============================ Header Zone ============================ -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceLevel1Brush}"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand mark: toggles the games drawer -->
                <Button x:Name="BrandButton" Grid.Column="0" Click="BrandButton_Click" Cursor="Hand"
                        WindowChrome.IsHitTestVisibleInChrome="True" Margin="8,0,4,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="8,4">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Source="Assets/icon-transparent.png" Width="22" Height="22"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           VerticalAlignment="Center"/>
                                    <TextBlock Text="SHUNT" FontSize="14" FontWeight="Black" Margin="7,0,0,0"
                                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <Path x:Name="Chevron" Data="M 0 0 L 4 4 L 8 0 Z" Fill="{StaticResource TextMutedBrush}"
                                          Margin="7,8,0,0" VerticalAlignment="Center"
                                          RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <RotateTransform x:Name="ChevronRotate" Angle="180"/>
                                        </Path.RenderTransform>
                                    </Path>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceLevel3Brush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Profile (game) + config target selectors.
                     IsHitTestVisibleInChrome is required: this row sits inside the 42px
                     WindowChrome caption band, otherwise clicks are consumed as caption drag. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                    <ComboBox x:Name="ProfileComboBox" Width="250" Style="{StaticResource DarkComboBox}"
                              ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                              DisplayMemberPath="Name"
                              WindowChrome.IsHitTestVisibleInChrome="True"
                              SelectionChanged="ProfileComboBox_SelectionChanged"
                              ToolTip="Game profile"/>
                    <ComboBox x:Name="TargetTypeCombo" Width="230" Style="{StaticResource DarkComboBox}"
                              ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                              SelectedValuePath="Value"
                              WindowChrome.IsHitTestVisibleInChrome="True"
                              SelectionChanged="TargetTypeCombo_SelectionChanged"
                              Margin="8,0,0,0" ToolTip="Virtual target controller emulated by Shunt">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding IconGlyph}" FontFamily="Segoe UI Emoji"
                                               FontSize="14" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="9"
                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- Shunt Mode Live Status Indicator -->
                <Button x:Name="ShuntLiveIndicator" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Click="ShuntLiveIndicator_Click" Cursor="Hand" WindowChrome.IsHitTestVisibleInChrome="True"
                        Visibility="Collapsed" Style="{StaticResource SecondaryButton}" Padding="10,3"
                        ToolTip="Click to open Shunt Mode Dashboard">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="ShuntLiveDot" Width="8" Height="8" Fill="{StaticResource StatusSuccessBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ShuntLiveTitle" Text="SHUNT MODE: ACTIVE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource StatusSuccessBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ShuntLiveDetails" Text=" · DS4 + DSU (UDP 26760)" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Hardware slot pills -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0"
                            ToolTip="Hardware slots (Ctrl+1..4)">
                    <RadioButton Style="{StaticResource SlotPill}" GroupName="Slots" Content="1" IsChecked="True" ToolTip="Slot 1 (Ctrl+1)" Padding="0"/>
                    <RadioButton Style="{StaticResource SlotPill}" GroupName="Slots" Content="2" ToolTip="Slot 2 (Ctrl+2)" Padding="0"/>
                    <RadioButton Style="{StaticResource SlotPill}" GroupName="Slots" Content="3" ToolTip="Slot 3 (Ctrl+3)" Padding="0"/>
                    <RadioButton Style="{StaticResource SlotPill}" GroupName="Slots" Content="4" ToolTip="Slot 4 (Ctrl+4)" Padding="0"/>
                </StackPanel>

                <!-- Master remap toggle + window controls -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton x:Name="RemapToggle" Template="{StaticResource RemapMasterToggleTemplate}"
                                  WindowChrome.IsHitTestVisibleInChrome="True" Cursor="Hand" Margin="0,0,10,0"
                                  Checked="RemapToggle_Changed" Unchecked="RemapToggle_Changed"
                                  ToolTip="Master remap switch"/>
                    <Button x:Name="SettingsButton" Style="{StaticResource WindowButton}" Click="SettingsButton_Click"
                            Content="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="11" ToolTip="Preferences"/>
                    <Button x:Name="PinButton" Style="{StaticResource WindowButton}" Click="PinButton_Click"
                            Content="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="11" ToolTip="Always on top"/>
                    <Button Style="{StaticResource WindowButton}" Click="MinimizeButton_Click"
                            Content="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="9" ToolTip="Minimize"/>
                    <Button x:Name="MaximizeButton" Style="{StaticResource WindowButton}" Click="MaximizeButton_Click"
                            Content="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="9" ToolTip="Maximize"/>
                    <Button Style="{StaticResource WindowCloseButton}" Click="CloseButton_Click"
                            Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="9" ToolTip="Close"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================ Games Drawer (collapsible) ============================ -->
        <Border x:Name="GamesDrawer" Grid.Row="1" Height="0" ClipToBounds="True" Visibility="Collapsed"
              Background="{StaticResource SurfaceLevel1Brush}"
              BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="12,10">
                    <TextBox x:Name="SearchGamesBox" Style="{StaticResource DarkTextBox}" Width="220"
                             TextChanged="SearchGamesBox_TextChanged" ToolTip="Search profiles"/>
                    <Button Style="{StaticResource SecondaryButton}" Content="New profile" Margin="8,0,0,0"
                            Click="NewProfileButton_Click"/>
                    <Button Style="{StaticResource SecondaryButton}" Content="Import Shunt profile…" Margin="6,0,0,0"
                            Click="OpenProfileButton_Click"/>
                    <Button Style="{StaticResource SecondaryButton}" Content="Community configs" Margin="6,0,0,0"
                            IsEnabled="False" ToolTip="Community config browser arrives with the cloud sync phase"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="8,0,8,10">
                    <StackPanel Orientation="Horizontal">
                        <ItemsControl x:Name="GameTilesControl" ItemTemplate="{StaticResource GameTileTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <Button Click="NewProfileButton_Click" Cursor="Hand" Width="128" Margin="4,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Width="128" Height="104" CornerRadius="6"
                                            Background="Transparent" BorderBrush="{StaticResource BorderSubtleBrush}"
                                            BorderThickness="1,1,1,1">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="+" FontSize="26" FontWeight="Light"
                                                       Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Add new" FontSize="10" Margin="0,4,0,0"
                                                       Foreground="{StaticResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ============================ Workspace: Nav Rail + Stage ============================ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Navigation rail -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceLevel1Brush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,1,0" Width="172">
                <StackPanel Margin="0,10">
                    <TextBlock Text="MAPPING MODE" FontSize="10" FontWeight="SemiBold" Margin="14,2,0,8"
                               Foreground="{StaticResource TextMutedBrush}"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Stage" Content="Gamepad view"
                                 Tag="{StaticResource IconGamepad}" IsChecked="True" Checked="NavItem_Checked" CommandParameter="gamepad"/>
                    <RadioButton x:Name="NavMappingsItem" Style="{StaticResource NavItem}" GroupName="Stage" Content="Mappings list"
                                 Tag="{StaticResource IconKeyboard}" Checked="NavItem_Checked" CommandParameter="mappings"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Stage" Content="Mouse"
                                 Tag="{StaticResource IconMouse}" Checked="NavItem_Checked" CommandParameter="mouse"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Stage" Content="Advanced sticks"
                                 Tag="{StaticResource IconStick}" Checked="NavItem_Checked" CommandParameter="sticks"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Stage" Content="Trigger zones"
                                 Tag="{StaticResource IconTrigger}" Checked="NavItem_Checked" CommandParameter="triggers"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Stage" Content="Gyroscope"
                                 Tag="{StaticResource IconGyro}" Checked="NavItem_Checked" CommandParameter="gyro"/>
                    <RadioButton x:Name="NavShuntItem" Style="{StaticResource NavItem}" GroupName="Stage" Content="Shunt mode"
                                 Tag="{StaticResource IconShunt}" Checked="NavItem_Checked" CommandParameter="shunt"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Stage" Content="Key combos"
                                 Tag="{StaticResource IconCombo}" Checked="NavItem_Checked" CommandParameter="combo"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Stage" Content="Radial menu"
                                 Tag="{StaticResource IconRadial}" Checked="NavItem_Checked" CommandParameter="radial"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="Stage" Content="Crosshair"
                                 Tag="{StaticResource IconCrosshair}" Checked="NavItem_Checked" CommandParameter="crosshair"/>

                    <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="10,12,10,10"/>
                    <Button x:Name="ThemeSwitchButton" Style="{StaticResource SecondaryButton}" Content="Theme: Dark"
                            Margin="10,0,10,0" Click="ThemeSwitchButton_Click" ToolTip="Switch between BaseTemplate dark and AimXP neon"/>
                </StackPanel>
            </Border>

            <!-- Stage region: exactly one stage panel is visible -->
            <Grid Grid.Column="1" Margin="0">
                <!-- Gamepad canvas stage + BindingFrame inspector drawer -->
                <Grid x:Name="StageGamepad" Background="{StaticResource CanvasBackgroundBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition x:Name="InspectorColumn" Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Row="1" Grid.Column="0">
                        <workspace:GamepadCanvasView x:Name="GamepadCanvas"/>
                        <workspace:KeyboardCanvasView x:Name="KeyboardCanvas" Visibility="Collapsed"/>
                        <workspace:MouseCanvasView x:Name="MouseCanvas" Visibility="Collapsed"/>
                    </Grid>
                    <inspector:BindingFrameView x:Name="BindingFrame" Grid.Row="1" Grid.Column="1" Width="0"
                                                Visibility="Collapsed"/>
                </Grid>

                <!-- Mappings list stage (profile editing surface) -->
                <Grid x:Name="StageMappings" Visibility="Collapsed" Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>

                    <!-- Profile / engine info column -->
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <Border Background="{StaticResource SurfaceLevel1Brush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="PROFILE INFO" Style="{StaticResource SectionHeaderText}" Margin="0,0,0,8"/>
                                <TextBlock x:Name="ProfileInfoText" Text="Open a profile to inspect its mappings."
                                           Style="{StaticResource BodyText}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource SurfaceLevel1Brush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="14">
                            <StackPanel>
                                <TextBlock Text="ENGINE" Style="{StaticResource SectionHeaderText}" Margin="0,0,0,8"/>
                                <TextBlock x:Name="DriverStatusText" Text="Driver status unavailable"
                                           Style="{StaticResource BodyText}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Mappings table -->
                    <Border Grid.Column="1" Background="{StaticResource SurfaceLevel1Brush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Margin="2,0,2,10">
                                <TextBlock Text="PROFILE MAPPINGS" Style="{StaticResource SectionHeaderText}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="MappingCountText" DockPanel.Dock="Right" Text="0 mappings"
                                           Style="{StaticResource TelemetryText}"/>
                            </DockPanel>
                            <DataGrid x:Name="MappingsGrid" Grid.Row="1" ItemsSource="{Binding Mappings}"
                                      SelectedItem="{Binding SelectedMapping, Mode=TwoWay}"
                                      SelectionChanged="MappingsGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Input" Binding="{Binding Source}" Width="1.1*"/>
                                    <DataGridTextColumn Header="Output" Binding="{Binding Target}" Width="1.2*"/>
                                    <DataGridTextColumn Header="Shift" Binding="{Binding Shift}" Width="70"/>
                                    <DataGridTextColumn Header="Activator" Binding="{Binding Activator}" Width="100"/>
                                    <DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- Mapping editor -->
                    <Border Grid.Column="2" Background="{StaticResource SurfaceLevel1Brush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="16">
                        <StackPanel>
                            <TextBlock Text="MAPPING EDITOR" Style="{StaticResource SectionHeaderText}" Margin="0,0,0,12"/>
                            <TextBlock Text="Selected input" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                            <TextBlock x:Name="SelectedInputText" Text="Select a mapping" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,3,0,14"/>

                            <TextBlock Text="Source for new mapping" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                            <controls:KeyPickerBox x:Name="InputControlCombo" Margin="0,0,0,12"/>

                            <TextBlock Text="Target output (Gamepad / Key / Mouse / Command)" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                            <controls:KeyPickerBox x:Name="TargetButtonCombo" Margin="0,0,0,12"/>

                            <TextBlock Text="Activator" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                            <ComboBox x:Name="ActivatorCombo" Style="{StaticResource DarkComboBox}"
                                      ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                                      DisplayMemberPath="Name" SelectedValuePath="Value" Margin="0,0,0,12"/>

                            <TextBlock Text="Mode" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                            <ComboBox x:Name="ModeCombo" Style="{StaticResource DarkComboBox}"
                                      ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                                      DisplayMemberPath="Name" SelectedValuePath="Value" Margin="0,0,0,12"/>

                            <TextBlock Text="Layer (Shift)" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                            <ComboBox x:Name="ShiftLayerCombo" Style="{StaticResource DarkComboBox}"
                                      ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                                      DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,14"/>

                            <Button x:Name="UpdateMappingButton" Style="{StaticResource PrimaryButton}" Content="Update mapping"
                                    Click="UpdateMappingButton_Click" IsEnabled="False"/>
                            <Button x:Name="AddMappingButton" Style="{StaticResource SecondaryButton}" Content="Add selected source → output"
                                    Click="AddMappingButton_Click" Margin="0,8,0,0"/>
                            <TextBlock x:Name="MappingHelpText" Text="Select a mapping to edit. Saving updates only that mapping and preserves other profile data."
                                       Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="3,12,3,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Planned stage placeholders (advanced tuning phases) -->
                <Border x:Name="StageMouse" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Mouse zones" Style="{StaticResource SectionHeaderText}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Mouse button, wheel and deflection remapping arrives in a later phase."
                                   Style="{StaticResource BodyText}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <tuners:StickCurvesVisualizer x:Name="StageSticks" Visibility="Collapsed"/>
                <tuners:TriggerZonesView x:Name="StageTriggers" Visibility="Collapsed"/>
                <tuners:GyroscopeView x:Name="StageGyro" Visibility="Collapsed"/>
                <tuners:ShuntModeView x:Name="StageShunt" Visibility="Collapsed"/>
                <macro:MacroTimelineView x:Name="StageCombo" Visibility="Collapsed"/>
                <radial:RadialMenuDesignerView x:Name="StageRadial" Visibility="Collapsed"/>
                <Border x:Name="StageCrosshair" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Crosshair designer" Style="{StaticResource SectionHeaderText}" HorizontalAlignment="Center"/>
                        <TextBlock Text="In-game crosshair overlay designer arrives in a later phase."
                                   Style="{StaticResource BodyText}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ============================ Footer Zone ============================ -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceLevel1Brush}"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Engine status + device tray -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource SurfaceLevel2Brush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="11,5" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="EngineStatusDot" Width="9" Height="9" Fill="{StaticResource StatusWarningBrush}"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="EngineStatusText" Text="Checking engine…" VerticalAlignment="Center"
                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                    <!-- Connected Device Dock -->
                    <Border x:Name="DeviceDockBorder" Background="{StaticResource SurfaceLevel2Brush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="6,3" VerticalAlignment="Center" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Empty / no device state -->
                            <StackPanel x:Name="NoDevicesPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,2" Visibility="Visible">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="No physical devices connected" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Connected device card -->
                            <StackPanel x:Name="ConnectedDevicePanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                <Ellipse x:Name="DeviceStatusDot" Width="8" Height="8" Fill="{StaticResource StatusSuccessBrush}" VerticalAlignment="Center" Margin="4,0,8,0"/>
                                <Path Data="M 2 8 C 2 5 5 2 8 2 L 16 2 C 19 2 22 5 22 8 L 22 13 C 22 17 19 20 16 20 L 15 20 L 13 16 L 11 16 L 9 20 L 8 20 C 5 20 2 17 2 13 Z M 6 9 L 6 11 L 8 11 L 8 9 Z M 5 10 L 9 10 Z M 16 9 A 1 1 0 1 0 16 11 A 1 1 0 1 0 16 9 Z M 18 11 A 1 1 0 1 0 18 13 A 1 1 0 1 0 18 11 Z"
                                      Width="16" Height="14" Stretch="Uniform" Fill="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                
                                <ComboBox x:Name="DeviceSelectorCombo" Width="220" Height="26" Margin="0,0,8,0"
                                          SelectionChanged="DeviceSelectorCombo_SelectionChanged"
                                          Style="{StaticResource DarkComboBox}"/>

                                <Border x:Name="DeviceTypeBadge" Background="{StaticResource SurfaceLevel3Brush}" CornerRadius="4" Padding="6,2" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="DeviceTypeText" Text="USB" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>

                                <Button x:Name="IdentifyDeviceButton" Style="{StaticResource SecondaryButton}" Content="⚡ Identify"
                                        Padding="8,3" FontSize="11" Click="IdentifyDeviceButton_Click"
                                        ToolTip="Send haptic rumble pulse to identify this physical controller"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Button x:Name="GroupDevicesButton" Style="{StaticResource SecondaryButton}" Content="+ Group devices" Margin="0,0,6,0" Click="GroupDevicesButton_Click"
                            ToolTip="Composite device grouping wizard"/>
                    <Button x:Name="DetectionModeButton" Style="{StaticResource SecondaryButton}" Content="Detection mode" Click="DetectionModeButton_Click"
                            ToolTip="Device detection mode to automatically listen for physical inputs"/>
                </StackPanel>

                <!-- Status strip -->
                <TextBlock x:Name="FooterStatusText" Grid.Column="1" Text="Ready. Open a profile to begin editing."
                           FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Margin="16,0"/>

                <!-- Action button group -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="DirtyStateText" Text="Saved" VerticalAlignment="Center" Margin="0,0,12,0"
                               FontSize="11" Foreground="{StaticResource StatusSuccessBrush}"/>
                    <Button Style="{StaticResource SecondaryButton}" Content="Reconnect" Click="ReconnectButton_Click"/>
                    <Button x:Name="StopProfileButton" Style="{StaticResource SecondaryButton}" Content="Stop"
                            Click="StopProfileButton_Click" IsEnabled="False" Margin="6,0,0,0"/>
                    <Button x:Name="SaveProfileButton" Style="{StaticResource SecondaryButton}" Content="Save"
                            Click="SaveProfileButton_Click" IsEnabled="False" Margin="6,0,0,0"/>
                    <Button x:Name="ApplyProfileButton" Style="{StaticResource PrimaryButton}" Content="Apply"
                            Click="ApplyProfileButton_Click" IsEnabled="False" Margin="6,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
