<UserControl x:Class="Shunt.UI.Controls.KeyPickerBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="32" d:DesignWidth="240">
    <Grid x:Name="RootGrid">
        <Border x:Name="InputBorder" Background="{DynamicResource SurfaceLevel2Brush}"
                BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1"
                CornerRadius="4" MinHeight="30">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="26"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         CaretBrush="{DynamicResource TextPrimaryBrush}"
                         VerticalContentAlignment="Center" Padding="8,4" FontSize="12"
                         TextChanged="SearchBox_TextChanged"
                         GotFocus="SearchBox_GotFocus"
                         PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                <ToggleButton x:Name="DropDownToggle" Grid.Column="1" Focusable="False"
                              Background="Transparent" BorderThickness="0" Cursor="Hand"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              IsChecked="{Binding IsOpen, ElementName=PickerPopup, Mode=TwoWay}">
                    <Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="{DynamicResource TextMutedBrush}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </ToggleButton>
            </Grid>
        </Border>

        <Popup x:Name="PickerPopup" PlacementTarget="{Binding ElementName=InputBorder}"
               Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade"
               StaysOpen="False" Focusable="False" Opened="PickerPopup_Opened" Closed="PickerPopup_Closed">
            <Border Background="{DynamicResource SurfacePopupBrush}"
                    BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1"
                    CornerRadius="4" Margin="0,3,0,0"
                    MinWidth="{Binding ActualWidth, ElementName=InputBorder}"
                    MaxHeight="260">
                <ListBox x:Name="PickerListBox" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         SelectionChanged="PickerListBox_SelectionChanged">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceLevel3Brush}" Padding="8,4" Margin="0,2,0,2">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11"
                                                   Foreground="{DynamicResource AccentCreamBrush}"/>
                                    </Border>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                            <Setter Property="Padding" Value="8,5"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceLevel4Brush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentCreamSubtleBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource AccentCreamBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Description}" FontSize="10"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Popup>
    </Grid>
</UserControl>
