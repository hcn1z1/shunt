<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Navigation rail glyph set. Icons bind Stroke to the ancestor's Foreground
         so they recolor with hover / checked states. Each key is consumed once. -->

    <Canvas x:Key="IconGamepad" Width="20" Height="14">
        <Path Data="M 2.6,1.5 L 17.4,1.5 C 18.7,1.5 19.8,2.5 20,3.8 L 20.9,9.6 C 21.1,11.4 19.7,12.9 17.9,12.7 L 15,12.3 L 12.9,10.6 L 7.1,10.6 L 5,12.3 L 2.1,12.7 C 0.3,12.9 -1.1,11.4 -0.9,9.6 L 0,3.8 C 0.2,2.5 1.3,1.5 2.6,1.5 Z"
              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.4" Fill="Transparent"/>
        <Ellipse Canvas.Left="3.4" Canvas.Top="4.4" Width="3.6" Height="3.6"
                 Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.2"/>
        <Ellipse Canvas.Left="13" Canvas.Top="4.4" Width="3.6" Height="3.6"
                 Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.2"/>
    </Canvas>

    <Canvas x:Key="IconKeyboard" Width="22" Height="14">
        <Rectangle Width="22" Height="14" RadiusX="2" RadiusY="2"
                   Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.3"/>
        <Rectangle Canvas.Left="2.5" Canvas.Top="3" Width="2.4" Height="2.4" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
        <Rectangle Canvas.Left="6.1" Canvas.Top="3" Width="2.4" Height="2.4" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
        <Rectangle Canvas.Left="9.7" Canvas.Top="3" Width="2.4" Height="2.4" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
        <Rectangle Canvas.Left="13.3" Canvas.Top="3" Width="2.4" Height="2.4" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
        <Rectangle Canvas.Left="16.9" Canvas.Top="3" Width="2.4" Height="2.4" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
        <Rectangle Canvas.Left="2.5" Canvas.Top="8" Width="7" Height="2.4" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
        <Rectangle Canvas.Left="11" Canvas.Top="8" Width="5" Height="2.4" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
        <Rectangle Canvas.Left="17.5" Canvas.Top="8" Width="2.4" Height="2.4" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
    </Canvas>

    <Canvas x:Key="IconMouse" Width="12" Height="20">
        <Rectangle Width="12" Height="20" RadiusX="6" RadiusY="6"
                   Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.3"/>
        <Line X1="6" Y1="2.5" X2="6" Y2="7.5"
              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.3"/>
        <Line X1="0.8" Y1="7.5" X2="11.2" Y2="7.5"
              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1"/>
    </Canvas>

    <Canvas x:Key="IconStick" Width="18" Height="18">
        <Ellipse Width="18" Height="18"
                 Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.3"/>
        <Ellipse Canvas.Left="5.4" Canvas.Top="5.4" Width="7.2" Height="7.2" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
    </Canvas>

    <Canvas x:Key="IconTrigger" Width="18" Height="18">
        <Path Data="M 9,2 A 8,8 0 0 0 1.4,11 L 9,11 Z"
              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
        <Path Data="M 9,2 A 8,8 0 0 1 16.6,11 L 9,11 Z"
              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.3"/>
        <Line X1="9" Y1="13.5" X2="9" Y2="16.5"
              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.3"/>
    </Canvas>

    <Canvas x:Key="IconGyro" Width="18" Height="18">
        <Ellipse Canvas.Left="1" Canvas.Top="1" Width="16" Height="16"
                 Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.2"/>
        <Ellipse Canvas.Left="4.2" Canvas.Top="6.6" Width="9.6" Height="5.2"
                 Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.1"/>
        <Ellipse Canvas.Left="7.6" Canvas.Top="7.6" Width="2.8" Height="2.8" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
    </Canvas>

    <Canvas x:Key="IconCombo" Width="18" Height="18">
        <Rectangle Canvas.Left="1" Canvas.Top="1" Width="7" Height="7" RadiusX="1.5" RadiusY="1.5"
                   Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.2"/>
        <Rectangle Canvas.Left="10" Canvas.Top="10" Width="7" Height="7" RadiusX="1.5" RadiusY="1.5"
                   Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
        <Line X1="9" Y1="4.5" X2="15.5" Y2="11"
              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.2"/>
    </Canvas>

    <Canvas x:Key="IconRadial" Width="18" Height="18">
        <Path Data="M 9,9 L 9,1 A 8,8 0 0 1 16.3,5.5 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
        <Path Data="M 9,9 L 16.3,5.5 A 8,8 0 0 1 16.3,12.5 Z"
              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.1"/>
        <Path Data="M 9,9 L 16.3,12.5 A 8,8 0 0 1 9,17 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
        <Path Data="M 9,9 L 9,17 A 8,8 0 0 1 1.7,12.5 Z"
              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.1"/>
        <Path Data="M 9,9 L 1.7,12.5 A 8,8 0 0 1 1.7,5.5 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
        <Path Data="M 9,9 L 1.7,5.5 A 8,8 0 0 1 9,1 Z"
              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.1"/>
    </Canvas>

    <Canvas x:Key="IconCrosshair" Width="18" Height="18">
        <Ellipse Canvas.Left="2.2" Canvas.Top="2.2" Width="13.6" Height="13.6"
                 Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.2"/>
        <Line X1="9" Y1="0" X2="9" Y2="5.4"
              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.2"/>
        <Line X1="9" Y1="12.6" X2="9" Y2="18"
              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.2"/>
        <Line X1="0" Y1="9" X2="5.4" Y2="9"
              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.2"/>
        <Line X1="12.6" Y1="9" X2="18" Y2="9"
              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.2"/>
        <Ellipse Canvas.Left="7.4" Canvas.Top="7.4" Width="3.2" Height="3.2" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
    </Canvas>

    <Canvas x:Key="IconShunt" Width="18" Height="18">
        <Path Data="M 10.5,1.5 L 4.5,9.5 L 9,9.5 L 7.5,16.5 L 13.5,8.5 L 9,8.5 Z"
              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
              StrokeThickness="1.1"/>
    </Canvas>

</ResourceDictionary>
