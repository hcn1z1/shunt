<Window x:Class="Shunt.UI.RadialMenuOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shunt Radial Menu" Height="420" Width="420"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" WindowStartupLocation="CenterScreen">

    <Grid>
        <!-- Center Circular Ring -->
        <Ellipse Width="360" Height="360" Fill="#CC11111B" Stroke="#89B4FA" StrokeThickness="3"/>
        <Ellipse Width="140" Height="140" Fill="#EE1E1E2E" Stroke="#45475A" StrokeThickness="2"/>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="🎯" FontSize="28" HorizontalAlignment="Center"/>
            <TextBlock x:Name="SelectedSlotText" Text="Radial Menu" FontWeight="Bold" FontSize="13" Foreground="#CDD6F4" HorizontalAlignment="Center"/>
            <TextBlock Text="Shift Layer 2" FontSize="11" Foreground="#A6ADC8" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- 8 Cardinal / Diagonal Radial Slots -->
        <!-- North -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,30,0,0" 
                Background="#313244" CornerRadius="8" Padding="12,6">
            <TextBlock Text="Slot 1: Primary Weapon" FontWeight="SemiBold" Foreground="#CDD6F4"/>
        </Border>

        <!-- South -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,30" 
                Background="#313244" CornerRadius="8" Padding="12,6">
            <TextBlock Text="Slot 5: Heavy / Special" FontWeight="SemiBold" Foreground="#CDD6F4"/>
        </Border>

        <!-- West -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0,0,0" 
                Background="#313244" CornerRadius="8" Padding="12,6">
            <TextBlock Text="Slot 7: Medkit" FontWeight="SemiBold" Foreground="#CDD6F4"/>
        </Border>

        <!-- East -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0" 
                Background="#313244" CornerRadius="8" Padding="12,6">
            <TextBlock Text="Slot 3: Grenade" FontWeight="SemiBold" Foreground="#CDD6F4"/>
        </Border>

        <!-- North-East -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,70,40,0" 
                Background="#313244" CornerRadius="8" Padding="10,5">
            <TextBlock Text="Slot 2: Secondary" FontSize="11" Foreground="#CDD6F4"/>
        </Border>

        <!-- North-West -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="40,70,0,0" 
                Background="#313244" CornerRadius="8" Padding="10,5">
            <TextBlock Text="Slot 8: Shield" FontSize="11" Foreground="#CDD6F4"/>
        </Border>

        <!-- South-East -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,40,70" 
                Background="#313244" CornerRadius="8" Padding="10,5">
            <TextBlock Text="Slot 4: Utility" FontSize="11" Foreground="#CDD6F4"/>
        </Border>

        <!-- South-West -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="40,0,0,70" 
                Background="#313244" CornerRadius="8" Padding="10,5">
            <TextBlock Text="Slot 6: Emote" FontSize="11" Foreground="#CDD6F4"/>
        </Border>
    </Grid>
</Window>
